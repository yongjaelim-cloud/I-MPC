std_msgs/Header header
uint32 seq_id
float64 cost
float64 dt

# Trajectory stage generated by the MPC planner.
# Stage 2 has strict priority over Stage 1 in ego_mover.
uint8 STAGE_1_AVOIDANCE=1
uint8 STAGE_2_AVOIDANCE_ADD_REGULATION=2
uint8 trajectory_type

# Candidate feasibility is finalized in utils_linearized: true iff s^r_k is zero
# for all horizon stages within the configured solver tolerance.
bool zero_slack_feasible

# Exact optimized state trajectory returned by utils_linearized/acados.
# Each array has H+1 elements and represents X = [x, y, v, yaw].
# plotter uses these states directly instead of re-integrating the controls.
float64[] xs
float64[] ys
float64[] vs
float64[] yaws

# Control sequence is kept for ego_mover/execution compatibility.
float64[] accs
float64[] yawrates
float64[] normal_slacks
# Ego state used as the MPC solve initial condition for this sequence.
# ego_mover rejects candidates whose start_ego_x/y do not match current ego pose.
float64 start_ego_x
float64 start_ego_y
float64 start_ego_z
float64 start_ego_v
float64 start_ego_yaw
