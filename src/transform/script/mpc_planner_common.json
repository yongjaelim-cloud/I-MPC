{
  "description": "Flag-organized single-source configuration. Set mpc_flag.selected and field_flag.selected. Mode-specific variables are grouped under the corresponding flag; variables shared across modes are under common. setter.py/setter_gazebo.py resolves the selected profiles and publishes the legacy typed /setup structure, so downstream nodes do not read JSON directly.",
  "mpc_flag": {
    "selected": 4,
    "0": {
      "name": "Uniform-slack MPC",
      "description": "Four exact ego-surface distance constraints; all four are relaxable with the same slack penalty.",
      "variables": {
        "surface_slack_max": 1000000.0,
        "q_surface_slack": 100000000.0
      }
    },
    "1": {
      "name": "Surface-wise MPC",
      "description": "The vulnerable surface selected by sector_id is hard; the other three exact surface constraints are relaxable.",
      "variables": {
        "surface_slack_max": 1000000.0,
        "q_nonvulnerable_slack": 100000000.0
      }
    },
    "2": {
      "name": "Weighted Vulnerability-Aware MPC",
      "description": "All four exact surface constraints are relaxable; the vulnerable surface receives the larger slack penalty.",
      "variables": {
        "surface_slack_max": 1000000.0,
        "q_nonvulnerable_slack": 100000000.0,
        "q_vulnerable_slack": 10000000000.0
      }
    },
    "3": {
      "name": "Lexicographic MPC",
      "description": "Vulnerable-surface violation is minimized first, fixed within tolerance, then the remaining surface violations are minimized.",
      "variables": {
        "surface_slack_max": 1000000.0,
        "q_nonvulnerable_slack": 100000000.0,
        "q_vulnerable_slack": 10000000000.0,
        "lexicographic_fix_tolerance": 1e-07
      }
    },
    "4": {
      "name": "Proposed minimum-distance + impact-location-conditioned MPC",
      "description": "Minimum-distance avoidance plus impact-location-conditioned relaxation. The proposed slack penalties are rho_s*(s_k^a)^2 and rho_c*(s_k^r)^2, and rho_impact weights the impact-alignment ranking term. dt_init is fixed and is not a decision variable.",
      "variables": {
        "enable_normal_mag_avoidance_constraint": true,
        "enable_impact_normal_constraint": true,
        "collision_slack_max": 1000000.0,
        "normal_alignment_slack_max": 1000000.0,
        "rho_s": 1000000.0,
        "rho_c": 1000000000.0,
        "rho_impact": 0.0,
        "global_candidate_objective": "sum_{k=1}^H ||x_k-x_G||_Q^2 + sum_{k=0}^{H-1} ||x_k-x_prev_tilde_k||_Qsim^2 - rho_Phi_global*sum_{k=1}^H Phi_k + rho_s*sum_{k=1}^H (s_k^a)^2 + rho_c*sum_{k=1}^H (s_k^r)^2 + rho_impact*sum_{k=1}^H (-grad Phi_k(0))^T n(phi_c)"
      }
    }
  },
  "field_flag": {
    "selected": 4,
    "0": {
      "name": "Circle-overestimation SDF",
      "description": "Circle-based over-approximation field.",
      "variables": {
        "circle_union_lambda": 0.0
      }
    },
    "1": {
      "name": "DCSAT field",
      "description": "DCSAT smooth collision field.",
      "variables": {
        "dcsat_alpha": 35.0,
        "dcsat_union_lambda": 0.02
      }
    },
    "2": {
      "name": "Geometry-Aware Bernstein-polynomial SDF",
      "description": "Geometry-aware Bernstein-polynomial SDF fitted from the obstacle geometry.",
      "variables": {
        "bp_order": 12,
        "bp_training_n_x": 25,
        "bp_training_n_y": 25,
        "bp_safety_margin_l": 0.13,
        "bp_domain_padding": 0.1
      }
    },
    "3": {
      "name": "Wu et al. (2025) smooth polygon field",
      "description": "Wu et al. smooth polygon field.",
      "variables": {
        "wu_kappa": 35.0,
        "wu_union_lambda": 0.02,
        "wu_buffer_offset": 0.0
      }
    },
    "4": {
      "name": "Proposed proximity field",
      "description": "Proposed edge/pseudo-vertex proximity field. N_n, epsilon_tot, epsilon_f, lambda_f, and lambda_o are derived automatically from theta, delta_o, delta_f, M_max, and F_max with epsilon_o fixed at 0.999. lambda_r is configured independently under common.mpc.",
      "variables": {}
    }
  },
