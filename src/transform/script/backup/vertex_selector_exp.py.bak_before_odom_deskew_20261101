def _load_setup_config(setup_topic="/setup"):
    """Receive and decode setter.py's latched /setup message."""
    rospy.loginfo("[vertex_selector] waiting for setup on %s", setup_topic)
    msg = rospy.wait_for_message(setup_topic, Setup)
    raw = setup_msg_to_raw(msg)
    if not isinstance(raw, dict):
        raise ValueError("/setup did not decode to a configuration dictionary")
    cfg = raw.get("config", {}) if isinstance(raw.get("config", {}), dict) else {}
    mpc_cfg = raw.get("mpc", {}) if isinstance(raw.get("mpc", {}), dict) else {}
    normal_cfg = raw.get("normal_cfg", {}) if isinstance(raw.get("normal_cfg", {}), dict) else {}
    ros_cfg = raw.get("ros", {}) if isinstance(raw.get("ros", {}), dict) else {}
    selector_cfg = raw.get("vertex_selector", {}) if isinstance(raw.get("vertex_selector", {}), dict) else {}
    return raw, cfg, mpc_cfg, normal_cfg, ros_cfg, selector_cfg

def _cfg_get(cfg: Dict, primary: str, fallback: str, default):
    if primary in cfg:
        return cfg[primary]
    if fallback is not None and fallback in cfg:
        return cfg[fallback]
    return default


def _get_nested(block: Dict, section: str, key: str, default):
    sub = block.get(section, {}) if isinstance(block, dict) else {}
    if isinstance(sub, dict) and key in sub:
        return sub[key]
    return default


def _as_bool(value, default=False):
    if value is None:
        return bool(default)
    if isinstance(value, bool):
        return value
    if isinstance(value, (int, float)):
        return bool(value)
    if isinstance(value, str):
        return value.strip().lower() in ("1", "true", "yes", "y", "on")
    return bool(default)



def wrap_to_pi(angle):
    return math.atan2(math.sin(float(angle)), math.cos(float(angle)))


def signed_polygon_area(vertices):
    V = np.asarray(vertices, dtype=float).reshape(-1, 2)
    if V.shape[0] < 3:
        return 0.0
    x = V[:, 0]
    y = V[:, 1]
    return 0.5 * float(np.sum(x * np.roll(y, -1) - y * np.roll(x, -1)))


def _cross2d(a, b):
    a = np.asarray(a, dtype=float).reshape(2)
    b = np.asarray(b, dtype=float).reshape(2)
    return float(a[0] * b[1] - a[1] * b[0])


def remove_duplicate_polygon_vertices(vertices, tol=1.0e-10):
    V = np.asarray(vertices, dtype=float).reshape(-1, 2)
    if V.shape[0] == 0:
        return V
    kept = [V[0]]
    for vertex in V[1:]:
        if float(np.linalg.norm(vertex - kept[-1])) > float(tol):
            kept.append(vertex)
    if len(kept) > 1 and float(np.linalg.norm(kept[0] - kept[-1])) <= float(tol):
        kept.pop()
    return np.asarray(kept, dtype=float).reshape(-1, 2)


def is_convex_polygon_2d(vertices, tol=1.0e-10):
    V = np.asarray(vertices, dtype=float).reshape(-1, 2)
    n = int(V.shape[0])
    if n < 3:
        return False
    sign = 0
    for i in range(n):
        z = _cross2d(V[(i + 1) % n] - V[i], V[(i + 2) % n] - V[(i + 1) % n])
        if abs(z) <= float(tol):
            continue
        current = 1 if z > 0.0 else -1
        if sign == 0:
            sign = current
        elif current != sign:
            return False
    return sign != 0


def point_in_triangle_2d(point, a, b, c, tol=1.0e-12):
    p = np.asarray(point, dtype=float).reshape(2)
    a = np.asarray(a, dtype=float).reshape(2)
    b = np.asarray(b, dtype=float).reshape(2)
    c = np.asarray(c, dtype=float).reshape(2)
    c1 = _cross2d(b - a, p - a)
    c2 = _cross2d(c - b, p - b)
    c3 = _cross2d(a - c, p - c)
    return c1 >= -tol and c2 >= -tol and c3 >= -tol


def convex_partition_polygon_ear_clipping(vertices):
    """Return CCW convex partitions; nonconvex polygons are triangulated."""
    V = remove_duplicate_polygon_vertices(vertices, 1.0e-10)
    if V.shape[0] < 3 or abs(signed_polygon_area(V)) < 1.0e-10:
        return []
    if signed_polygon_area(V) < 0.0:
        V = np.flipud(V)
    if is_convex_polygon_2d(V, 1.0e-10):
        return [V]

    active = list(range(int(V.shape[0])))
    parts = []
    max_iter = 10 * int(V.shape[0]) * int(V.shape[0])
    iteration = 0
    while len(active) > 3 and iteration < max_iter:
        iteration += 1
        ear_found = False
        for pos in range(len(active)):
            i_prev = active[(pos - 1) % len(active)]
            i_curr = active[pos]
            i_next = active[(pos + 1) % len(active)]
            a = V[i_prev]
            b = V[i_curr]
            c = V[i_next]
            if _cross2d(b - a, c - b) <= 1.0e-12:
                continue

            contains_other = False
            for i_test in active:
                if i_test in (i_prev, i_curr, i_next):
                    continue
                if point_in_triangle_2d(V[i_test], a, b, c, 1.0e-12):
                    contains_other = True
                    break
            if contains_other:
                continue

            parts.append(np.vstack((a, b, c)))
            del active[pos]
            ear_found = True
            break
        if not ear_found:
            return []

    if len(active) == 3:
        parts.append(V[active])

    valid = []
    for part in parts:
        part = remove_duplicate_polygon_vertices(part, 1.0e-10)
        if part.shape[0] < 3 or not is_convex_polygon_2d(part, 1.0e-10):
            return []
        if signed_polygon_area(part) < 0.0:
            part = np.flipud(part)
        valid.append(part)
    return valid



def _safe_set_array(msg, field, idx, value):
    if not hasattr(msg, field):
        return
    arr = getattr(msg, field)
    if idx < 0 or idx >= len(arr):
        return
    arr[idx] = value


def _safe_get_array(msg, field, idx, default):
    if not hasattr(msg, field):
        return default
    arr = getattr(msg, field)
    if idx < 0 or idx >= len(arr):
        return default
    return arr[idx]


class _CppVertexPipeline(object):
    """ctypes wrapper for the C++ raycast -> fitted/partitioned vertex pipeline."""

    _DP = ctypes.POINTER(ctypes.c_double)
    _IP = ctypes.POINTER(ctypes.c_int)

    def __init__(self, library_path):
        self.library_path = os.path.abspath(str(library_path))
        self.lib = ctypes.CDLL(self.library_path)
        self.fn = self.lib.vertex_selector_process
        DP, IP = self._DP, self._IP
        self.fn.argtypes = [
            DP, DP, ctypes.c_int, IP, IP, DP, DP, ctypes.c_int, ctypes.c_int,
            ctypes.c_double, ctypes.c_double, ctypes.c_double,
            ctypes.c_double, ctypes.c_double, ctypes.c_double,
            ctypes.c_double, ctypes.c_double, ctypes.c_int,
            ctypes.c_double, ctypes.c_double,
            ctypes.c_int, ctypes.c_int, ctypes.c_int,
            DP, ctypes.c_int, DP, ctypes.c_int, DP, ctypes.c_int,
            DP, ctypes.c_int, DP, ctypes.c_int, DP, ctypes.c_int,
            DP, ctypes.c_int, IP, ctypes.c_int,
        ]
        self.fn.restype = ctypes.c_int
        self.external_fn = getattr(self.lib, "vertex_selector_process_rays", None)
        if self.external_fn is not None:
            self.external_fn.argtypes = [
                DP, ctypes.c_int,
                ctypes.c_double, ctypes.c_double,
                ctypes.c_double, ctypes.c_double,
                ctypes.c_double, ctypes.c_double, ctypes.c_int,
                ctypes.c_double, ctypes.c_double,
                ctypes.c_int, ctypes.c_int,
                DP, ctypes.c_int, DP, ctypes.c_int, DP, ctypes.c_int,
                DP, ctypes.c_int, DP, ctypes.c_int, DP, ctypes.c_int,
                IP, ctypes.c_int,
            ]
            self.external_fn.restype = ctypes.c_int
        self.motion_fn = self.lib.vertex_selector_motion_update
        self.motion_fn.argtypes = [
            DP, ctypes.c_int, DP, ctypes.c_int, ctypes.c_int,
            ctypes.c_double, ctypes.c_double, ctypes.c_double, ctypes.c_double,
            ctypes.c_double, ctypes.c_double, ctypes.c_int,
            ctypes.c_double, ctypes.c_double, ctypes.c_double, ctypes.c_double,
            ctypes.c_double, ctypes.c_double, ctypes.c_int,
            DP, ctypes.c_int, DP, ctypes.c_int, IP, ctypes.c_int,
        ]
        self.motion_fn.restype = ctypes.c_int
        self.finalize_fn = self.lib.vertex_selector_finalize_selected
        self.finalize_fn.argtypes = [DP, ctypes.c_int, DP, ctypes.c_int, DP, ctypes.c_int]
        self.finalize_fn.restype = ctypes.c_int
        self.motion_reset_fn = getattr(self.lib, "vertex_selector_motion_reset", None)
        if self.motion_reset_fn is not None:
            self.motion_reset_fn.argtypes = []
            self.motion_reset_fn.restype = None
        self._capacities = None
        self.last_kernel_ms = 0.0
        self.last_motion_ms = 0.0
        self.last_motion_records = []
        # Fast planning path: publisher-ready arrays are produced directly from
        # the C++ output buffers.  Expensive Python geometry dictionaries are
        # reconstructed only on visualization/perceived-obstacle cycles.
        self.last_packed_publish = None
        # rospy creates a new message object for each /obstacle callback.  The
        # selector can run faster than the obstacle publisher, so avoid copying
        # the same fixed-size ROS arrays into NumPy on every selector tick.
        self._cached_obstacle_obj = None
        self._cached_inputs = None

    @staticmethod
    def _as_float_array(values, size, default=0.0):
        out = np.full(max(0, int(size)), float(default), dtype=np.float64)
        if values is None or out.size == 0:
            return out
        a = np.asarray(values, dtype=np.float64).reshape(-1)
        n = min(out.size, a.size)
        if n > 0:
            out[:n] = a[:n]
        return np.ascontiguousarray(out)

    @staticmethod
    def _as_int_array(values, size, default=0):
        out = np.full(max(0, int(size)), int(default), dtype=np.int32)
        if values is None or out.size == 0:
            return out
        a = np.asarray(values, dtype=np.int32).reshape(-1)
        n = min(out.size, a.size)
        if n > 0:
            out[:n] = a[:n]
        return np.ascontiguousarray(out)

    def _ensure_buffers(self, cap_rays, cap_segments, cap_vertices,
                        cap_terminal, cap_hits, cap_selected, cap_meta):
        caps = tuple(max(1, int(v)) for v in (
            cap_rays, cap_segments, cap_vertices, cap_terminal,
            cap_hits, cap_selected, cap_meta,
        ))
        if self._capacities == caps:
            return
        self._capacities = caps
        cr, cs, cv, ct, ch, csel, cm = caps
        self.rays = np.empty((cr, 10), dtype=np.float64)
        self.segments = np.empty((cs, 11), dtype=np.float64)
        self.vertices = np.empty((cv, 3), dtype=np.float64)
        self.terminal = np.empty((ct, 10), dtype=np.float64)
        self.hits = np.empty((ch, 3), dtype=np.float64)
        self.selected = np.empty((csel, 9), dtype=np.float64)
        self.packed_selected = np.empty((csel, 8), dtype=np.float64)
        self.meta = np.empty((cm, 4), dtype=np.float64)
        self.motion_meta = np.empty((cm, 7), dtype=np.float64)
        self.motion_records = np.empty((cv, 16), dtype=np.float64)
        self.motion_counts = np.zeros(2, dtype=np.int32)
        self.counts = np.zeros(10, dtype=np.int32)

    def _invoke(self, node, poly_x, poly_y, vertex_counts, obs_types, vx, vy,
                obs_cnt, stride, emit_rays):
        DP, IP = self._DP, self._IP
        self.counts.fill(0)
        t0 = time.perf_counter()
        rc = self.fn(
            poly_x.ctypes.data_as(DP), poly_y.ctypes.data_as(DP), int(poly_x.size),
            vertex_counts.ctypes.data_as(IP), obs_types.ctypes.data_as(IP),
            vx.ctypes.data_as(DP), vy.ctypes.data_as(DP),
            int(obs_cnt), int(stride),
            float(node.ego_x), float(node.ego_y), float(node.ego_yaw),
            float(node.obs_sensing_R), float(node.obs_fov_deg), float(node.ray_angle_step_deg),
            float(node.ray_cluster_gap), float(node.line_fit_max_error), int(node.line_fit_min_points),
            float(node.line_fit_min_length), float(node.line_intersection_max_extension),
            int(node.max_obs), int(node.field_flag), 1 if emit_rays else 0,
            self.rays.ctypes.data_as(DP), int(self.rays.shape[0]),
            self.segments.ctypes.data_as(DP), int(self.segments.shape[0]),
            self.vertices.ctypes.data_as(DP), int(self.vertices.shape[0]),
            self.terminal.ctypes.data_as(DP), int(self.terminal.shape[0]),
            self.hits.ctypes.data_as(DP), int(self.hits.shape[0]),
            self.selected.ctypes.data_as(DP), int(self.selected.shape[0]),
            self.meta.ctypes.data_as(DP), int(self.meta.shape[0]),
            self.counts.ctypes.data_as(IP), int(self.counts.size),
        )
        self.last_kernel_ms = (time.perf_counter() - t0) * 1000.0
        return int(rc)

    @staticmethod
    def ray_rows_to_records(rows):
        """Build legacy ray dictionaries only for RViz/Python fallback paths."""
        rows = np.asarray(rows, dtype=np.float64).reshape(-1, 10)
        return [
            {
                "rel_deg": float(row[0]),
                "direction": np.array(row[1:3], dtype=float),
                "endpoint": np.array(row[3:5], dtype=float),
                "distance": float(row[5]),
                "hit": bool(row[6] > 0.5),
                "hit_type": int(round(float(row[7]))),
                "hit_velocity": np.array(row[8:10], dtype=float),
            }
            for row in rows
        ]

    def _apply_feature_limit(self, node, nsel):
        """Limit complete convex groups per perceived obstacle on the C++ fast path."""
        zero_normal = np.zeros(2, dtype=float)
        original = self.selected[:nsel]
        rows = [
            (float(r[0]), np.array(r[1:3], dtype=float), zero_normal,
             int(round(r[3])), int(round(r[4])), int(round(r[5])),
             int(round(r[6])), "polygon_vertex", int(round(r[8])))
            for r in original
        ]
        if int(node.field_flag) != 4:
            return rows
        # Preserve original group identity during lookup; the limiter reindexes
        # kept groups and their local vertices, without splitting polygons.
        group_indices = {}
        for i, r in enumerate(original):
            group_indices.setdefault(int(round(r[5])), []).append(i)
        retained = _limit_selected_complete_groups(rows, node.F_max, node.N_n)
        # Retained partitions are ordered as in the C++ output, so match each
        # complete group by its source and vertex coordinates (not new group id).
        kept_indices = []
        consumed = set()
        for row in retained:
            source = int(row[4])
            xy = np.asarray(row[1], dtype=float)
            match = next((i for i, orig in enumerate(original)
                          if i not in consumed and int(round(orig[4])) == source
                          and float(orig[1]) == float(xy[0])
                          and float(orig[2]) == float(xy[1])), None)
            if match is None:
                raise RuntimeError("filtered vertex missing in packed C++ rows")
            consumed.add(match)
            kept_indices.append(match)
        cols = [np.ascontiguousarray(col[kept_indices])
                for col in self.last_packed_publish]
        cols[3] = np.asarray([r[5] for r in retained], dtype=np.int32)
        cols[4] = np.asarray([r[6] for r in retained], dtype=np.int32)
        self.last_packed_publish = tuple(cols)
        return retained

    def process_external(self, node, ray_rows):
        """Consume contiguous N x 10 ray rows and run fitting/partition/motion in C++."""
        if self.external_fn is None:
            raise RuntimeError("C++ library does not export vertex_selector_process_rays")

        rows = np.asarray(ray_rows, dtype=np.float64)
        if rows.size == 0:
            rows = np.empty((0, 10), dtype=np.float64)
        else:
            rows = rows.reshape(-1, 10)
            if not rows.flags.c_contiguous:
                rows = np.ascontiguousarray(rows)

        n_rays = int(rows.shape[0])
        base = max(8, n_rays + 2 * max(1, int(node.max_obs)))
        self._ensure_buffers(1, base, base, 2 * max(1, int(node.max_obs)) + 4,
                             n_rays + 4, 4 * base, max(1, int(node.max_obs)))

        DP, IP = self._DP, self._IP
        def invoke():
            self.counts.fill(0)
            t0 = time.perf_counter()
            rc = self.external_fn(
                rows.ctypes.data_as(DP), n_rays,
                float(getattr(node, "latest_cloud_origin", (node.ego_x, node.ego_y))[0]) if node.input_source == "velodyne_points" else float(node.ego_x),
                float(getattr(node, "latest_cloud_origin", (node.ego_x, node.ego_y))[1]) if node.input_source == "velodyne_points" else float(node.ego_y),
                float(node.obs_sensing_R), float(node.ray_angle_step_deg),
                float(node.ray_cluster_gap), float(node.line_fit_max_error), int(node.line_fit_min_points),
                float(node.line_fit_min_length), float(node.line_intersection_max_extension),
                int(node.max_obs), int(node.field_flag),
                self.segments.ctypes.data_as(DP), int(self.segments.shape[0]),
                self.vertices.ctypes.data_as(DP), int(self.vertices.shape[0]),
                self.terminal.ctypes.data_as(DP), int(self.terminal.shape[0]),
                self.hits.ctypes.data_as(DP), int(self.hits.shape[0]),
                self.selected.ctypes.data_as(DP), int(self.selected.shape[0]),
                self.meta.ctypes.data_as(DP), int(self.meta.shape[0]),
                self.counts.ctypes.data_as(IP), int(self.counts.size),
            )
            self.last_kernel_ms = (time.perf_counter() - t0) * 1000.0
            return int(rc)

        rc = invoke()
        if rc == -2:
            _nr, ng, ns, nv, nt, nh, nsel, nm = [int(v) for v in self.counts[:8]]
            self._ensure_buffers(1, max(ns, 1), max(nv, 1), max(nt, 1),
                                 max(nh, 1), max(nsel, 1), max(nm, ng, 1))
            rc = invoke()
        if rc != 0:
            raise RuntimeError("C++ external-ray vertex pipeline failed with status {}".format(rc))

        _nr, ng, ns, nv, nt, nh, nsel, nm, failed, group_count = [int(v) for v in self.counts]

        motion_stamp = getattr(node, "latest_raycast_observation_stamp", None)
        try:
            observation_sec = float(motion_stamp.to_sec()) if motion_stamp is not None else float(time.time())
        except Exception:
            observation_sec = float(time.time())
        emit_motion_records = bool(getattr(node, "_emit_cpp_motion_records", False))
        self.motion_counts.fill(0)
        motion_t0 = time.perf_counter()
        motion_vertices = self.vertices
        motion_segments = self.segments
        motion_x, motion_y, motion_yaw = node.ego_x, node.ego_y, node.ego_yaw
        use_world_motion = False  # cloud and selected vertices already expressed in map
        if use_world_motion:
            R = node.motion_world_rotation
            t = node.motion_world_translation
            motion_vertices = np.ascontiguousarray(self.vertices[:nv].copy())
            motion_segments = np.ascontiguousarray(self.segments[:ns].copy())
            motion_vertices[:, 1:3] = motion_vertices[:, 1:3] @ R.T + t
            for col in (1, 3):
                motion_segments[:, col:col+2] = motion_segments[:, col:col+2] @ R.T + t
            for col in (5, 7):
                motion_segments[:, col:col+2] = motion_segments[:, col:col+2] @ R.T
            motion_x, motion_y = float(t[0]), float(t[1])
            motion_yaw = float(node.motion_world_yaw)
        mrc = self.motion_fn(
            motion_vertices.ctypes.data_as(DP), int(nv),
            motion_segments.ctypes.data_as(DP), int(ns), int(ng),
            float(observation_sec),
            float(motion_x), float(motion_y), float(motion_yaw),
            float(node.obs_sensing_R), float(node.line_intersection_max_extension),
            1 if bool(node.estimate_vertex_velocity) else 0,
            float(node.vertex_match_max_distance), float(node.vertex_motion_min_displacement),
            float(node.vertex_dynamic_speed_threshold), float(node.vertex_velocity_max),
            float(node.vertex_velocity_alpha), float(node.vertex_track_max_dt),
            1 if emit_motion_records else 0,
            self.motion_meta.ctypes.data_as(DP), int(self.motion_meta.shape[0]),
            self.motion_records.ctypes.data_as(DP), int(self.motion_records.shape[0]),
            self.motion_counts.ctypes.data_as(IP), int(self.motion_counts.size),
        )
        self.last_motion_ms = (time.perf_counter() - motion_t0) * 1000.0
        if mrc != 0:
            raise RuntimeError("C++ motion tracker failed with status {}".format(mrc))
        if use_world_motion:
            # The tracker outputs map-frame absolute obstacle velocity.
            # Rotate vectors into base_link. Do NOT subtract robot velocity:
            # MPC predicts obstacles in a frame fixed at the current robot pose.
            self.motion_meta[:ng, 2:4] = self.motion_meta[:ng, 2:4] @ R
            if self.motion_counts[1] > 0:
                nr_motion = int(self.motion_counts[1])
                for col in (2, 4):
                    self.motion_records[:nr_motion, col:col+2] = (self.motion_records[:nr_motion, col:col+2] - t) @ R
                self.motion_records[:nr_motion, 6:8] = self.motion_records[:nr_motion, 6:8] @ R
                self.motion_records[:nr_motion, 10:12] = self.motion_records[:nr_motion, 10:12] @ R

        frc = self.finalize_fn(
            self.selected.ctypes.data_as(DP), int(nsel),
            self.motion_meta.ctypes.data_as(DP), int(ng),
            self.packed_selected.ctypes.data_as(DP), int(self.packed_selected.shape[0]),
        )
        if frc != 0:
            raise RuntimeError("C++ selected finalizer failed with status {}".format(frc))
        packed_view = self.packed_selected[:nsel]
        self.last_packed_publish = (
            packed_view[:, 0:2], packed_view[:, 2:4], packed_view[:, 4],
            packed_view[:, 5], packed_view[:, 6], packed_view[:, 7],
        )

        limited_selected = self._apply_feature_limit(node, nsel)

        self.last_motion_records = []
        nmr = int(self.motion_counts[1])
        if nmr > 0:
            for row in self.motion_records[:nmr]:
                self.last_motion_records.append({
                    "group_index": int(round(row[0])), "raycast_obs_idx": int(round(row[0])),
                    "vertex_index": int(round(row[1])),
                    "current_xy": np.array(row[2:4], dtype=float),
                    "previous_xy": np.array(row[4:6], dtype=float),
                    "delta": np.array(row[6:8], dtype=float),
                    "displacement": float(row[8]), "dt": float(row[9]),
                    "velocity": np.array(row[10:12], dtype=float),
                    "measurement_velocity": np.zeros(2, dtype=float),
                    "speed": float(row[12]), "matched": bool(row[13] > 0.5),
                    "valid": bool(row[14] > 0.5), "moving": bool(row[15] > 0.5),
                    "previous_index": -1, "previous_group_index": -1,
                    "ego_motion_compensated": False,
                    "stationary_reference_xy": np.array([np.nan, np.nan], dtype=float),
                })

        emit_geometry = bool(getattr(node, "_emit_cpp_python_geometry", False))
        fit_groups = []
        selected = None
        raycast_obstacle_meta = {}
        if emit_geometry:
            for gi in range(ng):
                fit_groups.append({
                    "raycast_obs_idx": gi, "group_id": gi, "obs_type": 0,
                    "velocity": np.zeros(2, dtype=float), "segments": [],
                    "vertices": np.zeros((0, 2), dtype=float), "terminal_ray_edges": [],
                    "hit_points": np.zeros((0, 2), dtype=float), "hit_records": [],
                })
            for row in self.motion_meta[:ng]:
                gi = int(round(row[0]))
                if 0 <= gi < ng:
                    vel = np.array(row[2:4], dtype=float)
                    fit_groups[gi]["obs_type"] = int(round(row[1]))
                    fit_groups[gi]["velocity"] = vel
                    raycast_obstacle_meta[gi] = {"obs_type": int(round(row[1])), "velocity": vel.copy()}
            for row in self.segments[:ns]:
                gi = int(round(row[0]))
                if 0 <= gi < ng:
                    fit_groups[gi]["segments"].append({
                        "center": 0.5 * (row[1:3] + row[3:5]),
                        "direction": np.array(row[5:7], dtype=float),
                        "normal": np.array(row[7:9], dtype=float),
                        "normal_out": np.array(row[7:9], dtype=float),
                        "start": np.array(row[1:3], dtype=float), "end": np.array(row[3:5], dtype=float),
                        "max_error": float(row[9]), "rms_error": float(row[10]),
                        "points": np.zeros((0, 2), dtype=float),
                    })
            vlists = [[] for _ in range(ng)]
            for row in self.vertices[:nv]:
                gi = int(round(row[0]))
                if 0 <= gi < ng: vlists[gi].append(np.array(row[1:3], dtype=float))
            for gi in range(ng):
                fit_groups[gi]["vertices"] = np.asarray(vlists[gi], dtype=float).reshape(-1, 2) if vlists[gi] else np.zeros((0,2))
            for row in self.terminal[:nt]:
                gi = int(round(row[0]))
                if 0 <= gi < ng:
                    fit_groups[gi]["terminal_ray_edges"].append({
                        "side": "start" if int(round(row[1])) < 0 else "end",
                        "start": np.array(row[2:4], dtype=float), "end": np.array(row[4:6], dtype=float),
                        "direction": np.array(row[6:8], dtype=float), "normal_out": np.array(row[8:10], dtype=float),
                    })
            selected = []
            zero_normal = np.zeros(2, dtype=float)
            for row in self.selected[:nsel]:
                selected.append((float(row[0]), np.array(row[1:3], dtype=float), zero_normal.copy(),
                                 int(round(row[3])), int(round(row[4])), int(round(row[5])),
                                 int(round(row[6])), "polygon_vertex", int(round(row[8]))))

        selected = limited_selected
        ng = len({int(r[4]) for r in selected})
        group_count = len({int(r[5]) for r in selected})

        ray_records = (
            self.ray_rows_to_records(rows)
            if bool(getattr(node, "_emit_cpp_ray_records", False))
            else []
        )
        return selected, int(ng), int(group_count), int(failed), ray_records, fit_groups, raycast_obstacle_meta

    def process(self, node, obstacle, emit_rays=False):
        obs_cnt = max(0, int(getattr(obstacle, "obs_cnt", 0)))
        stride = max(1, int(node.msg_max_vertices))
        required_poly_len = obs_cnt * stride

        cache_ok = (
            obstacle is self._cached_obstacle_obj
            and self._cached_inputs is not None
            and self._cached_inputs[0] == obs_cnt
            and self._cached_inputs[1] == stride
        )
        if cache_ok:
            _, _, poly_x, poly_y, vertex_counts, obs_types, vx, vy = self._cached_inputs
        else:
            poly_x = self._as_float_array(getattr(obstacle, "obs_poly_xs", None), required_poly_len)
            poly_y = self._as_float_array(getattr(obstacle, "obs_poly_ys", None), required_poly_len)
            vertex_counts = self._as_int_array(getattr(obstacle, "obs_vertex_counts", None), obs_cnt)
            if vertex_counts.size:
                np.clip(vertex_counts, 0, stride, out=vertex_counts)

            vx = self._as_float_array(getattr(obstacle, "obs_vxs", None), obs_cnt)
            vy = self._as_float_array(getattr(obstacle, "obs_vys", None), obs_cnt)
            if hasattr(obstacle, "obs_types"):
                obs_types = self._as_int_array(obstacle.obs_types, obs_cnt)
                obs_types[:] = (obs_types == 1).astype(np.int32)
            else:
                obs_types = ((np.abs(vx) + np.abs(vy)) > 1.0e-12).astype(np.int32)
            self._cached_obstacle_obj = obstacle
            self._cached_inputs = (obs_cnt, stride, poly_x, poly_y, vertex_counts, obs_types, vx, vy)

        # Total hit/fit complexity is bounded primarily by the ray count, not by
        # the number of world polygons.  Ear clipping can expand one n-gon to
        # roughly 3(n-2) selected vertices, hence the 4x ray allowance below.
        max_ray_count = int(math.ceil(360.0 / max(float(node.ray_angle_step_deg), 0.05))) + 8
        cap_rays = max_ray_count if emit_rays else 1
        cap_segments = max_ray_count + 2 * max(1, int(node.max_obs))
        cap_vertices = max_ray_count + 2 * max(1, int(node.max_obs))
        cap_terminal = 2 * max(1, int(node.max_obs)) + 4
        cap_hits = max_ray_count + 4
        cap_selected = 4 * (max_ray_count + 2 * max(1, int(node.max_obs)))
        cap_meta = max(1, int(node.max_obs))
        self._ensure_buffers(cap_rays, cap_segments, cap_vertices, cap_terminal,
                             cap_hits, cap_selected, cap_meta)

        rc = self._invoke(
            node, poly_x, poly_y, vertex_counts, obs_types, vx, vy,
            obs_cnt, stride, bool(emit_rays),
        )
        if rc == -2:
            # C++ reports the required row counts in self.counts. Resize once and retry.
            nr, _ng, ns, nv, nt, nh, nsel, nm = [int(v) for v in self.counts[:8]]
            self._ensure_buffers(
                max(cap_rays, nr), max(cap_segments, ns), max(cap_vertices, nv),
                max(cap_terminal, nt), max(cap_hits, nh), max(cap_selected, nsel),
                max(cap_meta, nm),
            )
            rc = self._invoke(
                node, poly_x, poly_y, vertex_counts, obs_types, vx, vy,
                obs_cnt, stride, bool(emit_rays),
            )
        if rc != 0:
            raise RuntimeError("C++ vertex pipeline failed with status {}".format(rc))

        nr, ng, ns, nv, nt, nh, nsel, nm, failed, group_count = [int(v) for v in self.counts]

        # Temporal association and velocity estimation stay in C++ while fitted
        # vertices/segments are still contiguous buffers.
        motion_stamp = getattr(node, "latest_obstacle_observation_stamp", None)
        try:
            observation_sec = float(motion_stamp.to_sec()) if motion_stamp is not None else float(time.time())
        except Exception:
            observation_sec = float(time.time())
        emit_motion_records = bool(getattr(node, "_emit_cpp_motion_records", False))
        self.motion_counts.fill(0)
        DP, IP = self._DP, self._IP
        motion_t0 = time.perf_counter()
        mrc = self.motion_fn(
            self.vertices.ctypes.data_as(DP), int(nv),
            self.segments.ctypes.data_as(DP), int(ns), int(ng),
            float(observation_sec),
            float(node.ego_x), float(node.ego_y), float(node.ego_yaw),
            float(node.obs_sensing_R), float(node.line_intersection_max_extension),
            1 if bool(node.estimate_vertex_velocity) else 0,
            float(node.vertex_match_max_distance), float(node.vertex_motion_min_displacement),
            float(node.vertex_dynamic_speed_threshold), float(node.vertex_velocity_max),
            float(node.vertex_velocity_alpha), float(node.vertex_track_max_dt),
            1 if emit_motion_records else 0,
            self.motion_meta.ctypes.data_as(DP), int(self.motion_meta.shape[0]),
            self.motion_records.ctypes.data_as(DP), int(self.motion_records.shape[0]),
            self.motion_counts.ctypes.data_as(IP), int(self.motion_counts.size),
        )
        self.last_motion_ms = (time.perf_counter() - motion_t0) * 1000.0
        if mrc != 0:
            raise RuntimeError("C++ motion tracker failed with status {}".format(mrc))

        # Finalize the planning-critical payload in C++ as well.  Python keeps
        # only zero-copy column views into this packed buffer.
        frc = self.finalize_fn(
            self.selected.ctypes.data_as(DP), int(nsel),
            self.motion_meta.ctypes.data_as(DP), int(ng),
            self.packed_selected.ctypes.data_as(DP), int(self.packed_selected.shape[0]),
        )
        if frc != 0:
            raise RuntimeError("C++ selected finalizer failed with status {}".format(frc))
        packed_view = self.packed_selected[:nsel]
        self.last_packed_publish = (
            packed_view[:, 0:2],  # xy
            packed_view[:, 2:4],  # vx, vy
            packed_view[:, 4],    # effective type
            packed_view[:, 5],    # group id
            packed_view[:, 6],    # local index
            packed_view[:, 7],    # obstacle reference
        )

        limited_selected = self._apply_feature_limit(node, nsel)

        ray_records = []
        if emit_rays and nr > 0:
            for row in self.rays[:nr]:
                ray_records.append({
                    "rel_deg": float(row[0]),
                    "direction": np.array(row[1:3], dtype=float),
                    "endpoint": np.array(row[3:5], dtype=float),
                    "distance": float(row[5]),
                    "hit": bool(row[6] > 0.5),
                    "hit_type": int(round(row[7])),
                    "hit_velocity": np.array(row[8:10], dtype=float),
                })

        # Python geometry is auxiliary.  Reconstruct it only when line RViz,
        # /percepted_obstacle, or explicit semantic debugging needs it.
        emit_geometry = bool(getattr(node, "_emit_cpp_python_geometry", False))
        raycast_obstacle_meta = {}
        fit_groups = []
        selected = None

        if emit_geometry:
            for gi in range(ng):
                fit_groups.append({
                    "raycast_obs_idx": int(gi),
                    "group_id": int(gi),
                    "obs_type": 0,
                    "velocity": np.zeros(2, dtype=float),
                    "segments": [],
                    "vertices": np.zeros((0, 2), dtype=float),
                    "terminal_ray_edges": [],
                    "hit_points": np.zeros((0, 2), dtype=float),
                    "hit_records": [],
                })

            for row in self.motion_meta[:ng]:
                gi = int(round(row[0]))
                if gi < 0 or gi >= len(fit_groups):
                    continue
                obs_type = int(round(row[1]))
                vel = np.array(row[2:4], dtype=float)
                speed = float(row[4])
                valid = bool(row[5] > 0.5)
                displacement = float(row[6])
                fit_groups[gi]["obs_type"] = obs_type
                fit_groups[gi]["velocity"] = vel.copy()
                fit_groups[gi]["estimated_speed"] = speed
                fit_groups[gi]["estimated_displacement"] = displacement
                fit_groups[gi]["velocity_valid"] = valid
                raycast_obstacle_meta[gi] = {
                    "obs_type": obs_type, "velocity": vel.copy(),
                    "estimated_speed": speed, "estimated_displacement": displacement,
                    "velocity_valid": valid, "velocity_source": "cpp_temporal_tracker",
                }

            for row in self.segments[:ns]:
                gi = int(round(row[0]))
                if gi < 0 or gi >= len(fit_groups):
                    continue
                start = np.array(row[1:3], dtype=float)
                end = np.array(row[3:5], dtype=float)
                direction = np.array(row[5:7], dtype=float)
                normal_out = np.array(row[7:9], dtype=float)
                fit_groups[gi]["segments"].append({
                    "center": 0.5 * (start + end),
                    "direction": direction,
                    "normal": normal_out.copy(),
                    "normal_out": normal_out,
                    "start": start,
                    "end": end,
                    "max_error": float(row[9]),
                    "rms_error": float(row[10]),
                    "points": np.zeros((0, 2), dtype=float),
                })

            vertex_lists = [[] for _ in range(ng)]
            for row in self.vertices[:nv]:
                gi = int(round(row[0]))
                if 0 <= gi < ng:
                    vertex_lists[gi].append(np.array(row[1:3], dtype=float))
            for gi in range(ng):
                fit_groups[gi]["vertices"] = (
                    np.asarray(vertex_lists[gi], dtype=float).reshape(-1, 2)
                    if vertex_lists[gi] else np.zeros((0, 2), dtype=float)
                )

            hit_lists = [[] for _ in range(ng)]
            for row in self.hits[:nh]:
                gi = int(round(row[0]))
                if 0 <= gi < ng:
                    hit_lists[gi].append(np.array(row[1:3], dtype=float))
            for gi in range(ng):
                fit_groups[gi]["hit_points"] = (
                    np.asarray(hit_lists[gi], dtype=float).reshape(-1, 2)
                    if hit_lists[gi] else np.zeros((0, 2), dtype=float)
                )

            for row in self.terminal[:nt]:
                gi = int(round(row[0]))
                if gi < 0 or gi >= ng:
                    continue
                side = "start" if int(round(row[1])) < 0 else "end"
                fit_groups[gi]["terminal_ray_edges"].append({
                    "side": side,
                    "start": np.array(row[2:4], dtype=float),
                    "end": np.array(row[4:6], dtype=float),
                    "direction": np.array(row[6:8], dtype=float),
                    "normal_out": np.array(row[8:10], dtype=float),
                })

            selected = []
            first_group = {}
            zero_normal = np.zeros(2, dtype=float)
            for row in self.selected[:nsel]:
                obs_idx = int(round(row[4]))
                gid = int(round(row[5]))
                first_group.setdefault(obs_idx, gid)
                selected.append((
                    float(row[0]),
                    np.array(row[1:3], dtype=float),
                    zero_normal.copy(),
                    int(round(row[3])),
                    obs_idx,
                    gid,
                    int(round(row[6])),
                    "polygon_vertex",
                    int(round(row[8])),
                ))
            for gi, group in enumerate(fit_groups):
                group["group_id"] = int(first_group.get(gi, gi))

        selected = limited_selected
        ng = len({int(r[4]) for r in selected})
        group_count = len({int(r[5]) for r in selected})

        self.last_motion_records = []
        nmr = int(self.motion_counts[1])
        if nmr > 0:
            for row in self.motion_records[:nmr]:
                gi = int(round(row[0]))
                vi = int(round(row[1]))
                rec = {
                    "group_index": gi, "raycast_obs_idx": gi, "vertex_index": vi,
                    "current_xy": np.array(row[2:4], dtype=float),
                    "previous_xy": np.array(row[4:6], dtype=float),
                    "delta": np.array(row[6:8], dtype=float),
                    "displacement": float(row[8]), "dt": float(row[9]),
                    "velocity": np.array(row[10:12], dtype=float),
                    "measurement_velocity": np.zeros(2, dtype=float),
                    "speed": float(row[12]), "matched": bool(row[13] > 0.5),
                    "valid": bool(row[14] > 0.5), "moving": bool(row[15] > 0.5),
                    "previous_index": -1, "previous_group_index": -1,
                    "ego_motion_compensated": False,
                    "stationary_reference_xy": np.array([np.nan, np.nan], dtype=float),
                }
                self.last_motion_records.append(rec)
                if emit_geometry and 0 <= gi < len(fit_groups):
                    fit_groups[gi].setdefault("vertex_motion", []).append(rec)

        return (
            selected,
            int(ng),
            int(group_count),
            int(failed),
            ray_records,
            fit_groups,
            raycast_obstacle_meta,
        )


def _limit_selected_complete_groups(selected, max_features, pseudo_count):
    """Apply F_max independently to each original obstacle, never globally.

    Each complete convex partition costs len(vertices) * (N_n + 1).
    Preserve entire polygons and group/local indexing for the C++ field.
    """
    if not selected:
        return selected
    per_obstacle_limit = max(0, int(max_features))
    weight = max(1, int(pseudo_count) + 1)
    groups = {}
    order = []
    for row in selected:
        gid = int(row[5])
        if gid not in groups:
            groups[gid] = []
            order.append(gid)
        groups[gid].append(row)
    used_by_source = {}
    kept = []
    new_group_id = 0
    for gid in order:
        rows = sorted(groups[gid], key=lambda r: int(r[6]))
        if len(rows) < 3:
            continue
        source_id = int(rows[0][4])
        cost = weight * len(rows)
        if used_by_source.get(source_id, 0) + cost > per_obstacle_limit:
            continue
        for local_idx, row in enumerate(rows):
            row_copy = list(row)
            row_copy[5] = new_group_id
            row_copy[6] = local_idx
            kept.append(tuple(row_copy))
        used_by_source[source_id] = used_by_source.get(source_id, 0) + cost
        new_group_id += 1
    return kept

class VertexSelectorNode(object):
    def __init__(self):
        self.setup_topic = str(rospy.get_param("~setup_topic", "/setup"))
        self.raw_cfg, self.config_cfg, self.mpc_cfg, self.normal_cfg, self.ros_cfg, self.selector_cfg = _load_setup_config(self.setup_topic)
        self.raw_setup = self.raw_cfg
        ego_cfg = self.raw_cfg.get("ego", {}) if isinstance(self.raw_cfg.get("ego", {}), dict) else {}

        self.frame_id = "map"  # Planner geometry is in Cartographer map.
        self.world_frame = self.frame_id
        self.rviz_target_frame = "map"  # All planning and RViz geometry is map-referenced.
        self.odom_frame = "map"  # No odom frame; compatibility only.
        self.tf_buffer = tf2_ros.Buffer(cache_time=rospy.Duration(30.0))
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer)
        self.latest_tracked_pose = None
        self.tracked_pose_lock = __import__("threading").Lock()
        # Collision field selection is needed here only to decide whether the
        # complete augmented obstacle (field 0) or its convex partitions
        # (fields 1--4) are sent downstream.
        raw_field_flag = rospy.get_param(
            "~field_flag",
            self.normal_cfg.get("field_flag", self.mpc_cfg.get("field_flag", 4)),
        )
        try:
            self.field_flag = int(round(float(raw_field_flag)))
        except Exception:
            self.field_flag = 4
        if self.field_flag not in (0, 1, 2, 3, 4):
            raise ValueError("field_flag must be one of 0,1,2,3,4; got {!r}".format(self.field_flag))
        # Keep the original 100 Hz default, but allow the selector rate to be
        # reduced from /setup or a private ROS parameter when CPU load matters.
        self.hz = max(1.0, float(rospy.get_param(
            "~hz",
            self.selector_cfg.get("hz", 100.0),
        )))
        self.debug_timing = bool(rospy.get_param(
            "~debug_timing",
            self.selector_cfg.get("debug_timing", False),
        ))
        self.ego_x = float(rospy.get_param("~ego_x", ego_cfg.get("ego_x", self.config_cfg.get("ego_x", 0.0))))
        self.ego_y = float(rospy.get_param("~ego_y", ego_cfg.get("ego_y", self.config_cfg.get("ego_y", 0.0))))
        self.ego_yaw = float(rospy.get_param("~ego_yaw", ego_cfg.get("ego_yaw", self.config_cfg.get("ego_yaw", 0.0))))
        self.ego_L = float(ego_cfg.get("ego_L", 0.0))
        self.ego_W = float(ego_cfg.get("ego_W", 0.0))
        self.use_ego_scaled_local_frame = _as_bool(rospy.get_param(
            "~use_ego_scaled_local_frame",
            self.normal_cfg.get("use_ego_scaled_local_frame", False),
        ), False)

        self.obs_sensing_R = float(rospy.get_param(
            "~obs_sensing_R",
            _cfg_get(self.config_cfg, "FOV", "obs_sensing_R", self.mpc_cfg.get("obs_sensing_R", 4.0)),
        ))
        self.obs_fov_deg = float(rospy.get_param(
            "~obs_fov_deg",
            _cfg_get(self.config_cfg, "obs_fov_deg", "obs_fov_angle_deg", self.mpc_cfg.get("obs_fov_deg", 80.0)),
        ))
        self.max_obs = int(rospy.get_param(
            "~max_obs",
            self.selector_cfg.get("max_obs", self.config_cfg.get("max_obs", 15)),
        ))
        self.max_obs = max(0, int(self.max_obs))
        self.M_max = max(0, int(self.mpc_cfg.get("M_max", self.max_obs)))
        self.F_max = max(0, int(self.mpc_cfg.get("F_max", 200)))
        self.N_n = max(0, int(self.normal_cfg.get("N_n", self.mpc_cfg.get("N_n", 5))))
        self.max_obs = min(self.max_obs, self.M_max)
        # Number of polygon-vertex slots reserved per obstacle in the flattened
        # obs_poly_* message arrays.  This is a message-layout stride, NOT a
        # selector-side vertex budget.  In particular, there is no hard-coded
        # MAX_VERTICES clamp in this node.
        self.msg_max_vertices = max(1, int(rospy.get_param(
            "~msg_max_vertices",
            self.mpc_cfg.get(
                "msg_max_vertices",
                self.config_cfg.get("obs_max_vertex_num", 10),
            ),
        )))

        # Raycast-based visible-shape estimation.  Rays are generated from
        # 0:ray_angle_step_deg:360 in the ego frame and then restricted by the
        # existing FOV half-angle.  The 360-deg ray is directionally identical
        # to 0 deg, so it is coalesced before intersection testing.
        self.use_raycast_shape_estimation = _as_bool(rospy.get_param(
            "~use_raycast_shape_estimation",
            self.selector_cfg.get("use_raycast_shape_estimation", True),
        ), True)
        self.ray_angle_step_deg = max(0.05, float(rospy.get_param(
            "~ray_angle_step_deg",
            self.selector_cfg.get("ray_angle_step_deg", 0.5),
        )))
        self.ray_cluster_gap = max(1.0e-3, float(rospy.get_param(
            "~ray_cluster_gap",
            self.selector_cfg.get("ray_cluster_gap", 0.20),
        )))
        self.line_fit_max_error = max(1.0e-4, float(rospy.get_param(
            "~line_fit_max_error",
            self.selector_cfg.get("line_fit_max_error", 0.04),
        )))
        self.line_fit_min_points = max(2, int(rospy.get_param(
            "~line_fit_min_points",
            self.selector_cfg.get("line_fit_min_points", 4),
        )))
        self.line_fit_min_length = max(1.0e-4, float(rospy.get_param(
            "~line_fit_min_length",
            self.selector_cfg.get("line_fit_min_length", 0.04),
        )))
        self.line_intersection_max_extension = max(0.0, float(rospy.get_param(
            "~line_intersection_max_extension",
            self.selector_cfg.get("line_intersection_max_extension", 0.25),
        )))
        self.publish_raycast_viz = _as_bool(rospy.get_param(
            "~publish_raycast_viz",
            self.selector_cfg.get("publish_raycast_viz", True),
        ), True)
        self.publish_line_fit_viz = _as_bool(rospy.get_param(
            "~publish_line_fit_viz",
            self.selector_cfg.get("publish_line_fit_viz", True),
        ), True)
        # RViz/debug publishers do not affect planning.  Throttle them separately
        # so a 100 Hz selector does not spend most of its time constructing and
        # serializing MarkerArray / debug messages.
        self.visualization_hz = max(0.0, float(rospy.get_param(
            "~visualization_hz",
            self.selector_cfg.get("visualization_hz", min(20.0, float(self.hz))),
        )))
        self.motion_debug_hz = max(0.0, float(rospy.get_param(
            "~motion_debug_hz",
            self.selector_cfg.get("motion_debug_hz", min(20.0, float(self.hz))),
        )))
        self._last_visualization_sec = -float("inf")
        self._last_motion_debug_sec = -float("inf")
        # Expensive RViz/debug/auxiliary ROS messages are built only when a
        # subscriber exists.  Planning-critical selected/current+horizon topics
        # are still produced every selector cycle.
        self.skip_unsubscribed_aux_publish = _as_bool(rospy.get_param(
            "~skip_unsubscribed_aux_publish",
            self.selector_cfg.get("skip_unsubscribed_aux_publish", True),
        ), True)

        # Temporal vertex tracking.  Raycast obstacle IDs are reconstructed every
        # frame, so velocity is estimated geometrically: each current fitted
        # visible vertex is matched to the nearest fitted vertex from the previous
        # frame, subject to a displacement gate.
        self.estimate_vertex_velocity = _as_bool(rospy.get_param(
            "~estimate_vertex_velocity",
            self.selector_cfg.get("estimate_vertex_velocity", True),
        ), True)
        self.vertex_match_max_distance = max(1.0e-4, float(rospy.get_param(
            "~vertex_match_max_distance",
            self.selector_cfg.get("vertex_match_max_distance", 0.50),
        )))
        self.vertex_motion_min_displacement = max(0.0, float(rospy.get_param(
            "~vertex_motion_min_displacement",
            self.selector_cfg.get("vertex_motion_min_displacement", 0.005),
        )))
        self.vertex_dynamic_speed_threshold = max(0.0, float(rospy.get_param(
            "~vertex_dynamic_speed_threshold",
            self.selector_cfg.get("vertex_dynamic_speed_threshold", 0.20),
        )))
        self.vertex_velocity_max = max(1.0e-3, float(rospy.get_param(
            "~vertex_velocity_max",
            self.selector_cfg.get("vertex_velocity_max", 5.0),
        )))
        self.vertex_velocity_alpha = min(1.0, max(0.0, float(rospy.get_param(
            "~vertex_velocity_alpha",
            self.selector_cfg.get("vertex_velocity_alpha", 0.7),
        ))))
        self.vertex_track_max_dt = max(1.0e-3, float(rospy.get_param(
            "~vertex_track_max_dt",
            self.selector_cfg.get("vertex_track_max_dt", 0.50),
        )))
        # Previous raycast-reconstructed obstacle groups used for temporal
        # association.  Each entry stores the fitted visible vertices and the
        # obstacle-level velocity estimated from those vertices.
        self.previous_obstacle_tracks = []
        self.previous_fitted_vertex_stamp = None
        # Ego pose sampled at the same selector step as previous_obstacle_tracks.
        # It is used to detect viewpoint motion between consecutive raycast fits.
        self.previous_fitted_vertex_ego_pose = None

        # Horizon obstacle prediction only.  Uncertainty inflation is applied
        # downstream in the C++ feature score, not by shifting selector geometry.
        self.horizon_N = max(1, int(rospy.get_param("~N", self.mpc_cfg.get("N", 20))))
        self.prediction_dt = float(rospy.get_param("~dt", self.mpc_cfg.get("dt_init", 0.1)))
        # Publishing fast path: cache horizon time offsets/layout metadata instead
        # of rebuilding them at every selector tick.
        self._horizon_tau = (
            np.arange(1, self.horizon_N + 1, dtype=np.float64) * float(self.prediction_dt)
        )
        self._horizon_layout_cache = {}
        # /percepted_obstacle is an auxiliary visualization/inspection topic.
        # It does not feed the planner, so avoid serializing its large fixed-size
        # obstacle_polygon message at the full selector rate by default.
        self.perceived_obstacle_hz = max(0.0, float(rospy.get_param(
            "~perceived_obstacle_hz",
            self.selector_cfg.get("perceived_obstacle_hz", min(20.0, float(self.hz))),
        )))
        self._last_perceived_publish_sec = -float("inf")
        # Float64MultiArray serialization is a measurable part of horizon_pub.
        # rospy.numpy_msg keeps the wire type unchanged while serializing the
        # NumPy payload directly, avoiding payload.reshape(-1).tolist().
        self._use_numpy_horizon_msg = bool(
            numpy_msg is not None and _as_bool(rospy.get_param(
                "~use_numpy_horizon_msg",
                self.selector_cfg.get("use_numpy_horizon_msg", True),
            ), True)
        )
        self._horizon_msg_cls = numpy_msg(Float64MultiArray) if self._use_numpy_horizon_msg else Float64MultiArray


        input_topics = self.ros_cfg.get("input_topics", {}) if isinstance(self.ros_cfg.get("input_topics", {}), dict) else {}
        selector_inputs = self.selector_cfg.get("input_topics", {}) if isinstance(self.selector_cfg.get("input_topics", {}), dict) else {}
        selector_pubs = self.selector_cfg.get("publishers", {}) if isinstance(self.selector_cfg.get("publishers", {}), dict) else {}

        ego_state_topic = str(selector_inputs.get("ego_state", input_topics.get("ego_state", "/ego_state")))
        obstacle_topic = str(selector_inputs.get("obstacle", input_topics.get("obstacle", "/obstacle")))
        self.raycast_point_cloud_topic = str(rospy.get_param(
            "~raycast_point_cloud_topic",
            selector_inputs.get("raycast_point_cloud", "/raycast/point_cloud"),
        ))
        # PointCloud2 is the default sensor input. No /scan dependency.
        # Legacy simulation modes remain available.
        self.input_source = str(rospy.get_param(
            "~input_source", "velodyne_points"
        )).strip().lower()
        if self.input_source not in ("velodyne_points", "raycast_cloud", "obstacle"):
            raise ValueError("~input_source must be velodyne_points, raycast_cloud, or obstacle")
        self.use_external_raycast = self.input_source != "obstacle"
        # Subscribe to the raw LiDAR cloud directly.  The callback already
        # performs sensor-frame height filtering and TF to map internally.
        # No intermediate converted cloud topic is required.
        self.velodyne_points_topic = str(rospy.get_param(
            "~velodyne_points_topic", "/velodyne_ponints_interest"))
        # Filter in the sensor frame. Adjust for actual sensor mounting height.
        self.cloud_z_min = float(rospy.get_param("~cloud_z_min", -0.3))
        self.cloud_z_max = float(rospy.get_param("~cloud_z_max", 0.5))
        self.cloud_min_range = max(0.0, float(rospy.get_param("~cloud_min_range", 0.25)))
        self.cloud_angle_step_deg = max(0.05, float(rospy.get_param("~cloud_angle_step_deg", 0.5)))
        # A rotating ego-centered virtual FOV clips stationary walls and makes
        # their fitted endpoints/terminal edges rotate in map. Velodyne is a
        # 360-degree sensor: use the entire observed scan by default. For a
        # physically limited-FOV sensor this can be set to its actual FOV.
        self.cloud_fov_deg = max(0.0, min(360.0, float(rospy.get_param("~cloud_fov_deg", 360.0))))
        self.cloud_max_points = max(0, int(rospy.get_param("~cloud_max_points", 0)))
        self.cloud_use_latest_tf = False  # Always use measurement-time TF for motion estimation.
        # Line fitting and the C++ motion tracker run in a *continuous* frame.
        # map->odom is a localization correction that jumps (cm..dm, ~1 deg)
        # every few scans; in map those jumps look like obstacle motion
        # (2 cm / 0.05 s = 0.4 m/s on a static wall).  Outputs are converted
        # back to map (positions) / rotated (velocities) after tracking.
        # Set to "map" to restore the previous behaviour.
        self.cloud_motion_frame = str(rospy.get_param("~cloud_motion_frame", "odom")).lstrip("/") or "map"
        # Per-point deskew: a Velodyne sweep spans 50-100 ms and its header
        # stamp is the end of the sweep.  Projecting every point with the TF at
        # the header stamp smears the scan by (yaw rate x sweep time), e.g.
        # 1.2 rad/s x 0.05 s = 3.5 deg = 25 cm at 4 m, which bends fitted lines
        # and moves vertices whenever the robot turns.
        self.cloud_deskew = _as_bool(rospy.get_param("~cloud_deskew", True), True)
        self.cloud_time_field = str(rospy.get_param("~cloud_time_field", "time"))
        self.cloud_deskew_samples = max(2, int(rospy.get_param("~cloud_deskew_samples", 4)))
        self.latest_cloud_motion = None
        self.cloud_robot_center_frame = str(rospy.get_param("~cloud_robot_center_frame", "base_link")).lstrip("/")
        self.selected_vertex_data_topic = str(selector_pubs.get("selected_vertex_data", "/selected_vertex_data"))
        self.selected_vertex_horizon_data_topic = str(
            selector_pubs.get("selected_vertex_horizon_data", "/selected_vertex_horizon_data")
        )
        self.percepted_obstacle_topic = str(selector_pubs.get("percepted_obstacle", "/percepted_obstacle"))
        # Visible-surface-only obstacle set for guidance planning.  Unlike
        # /percepted_obstacle and /selected_vertex_data, this topic never adds
        # terminal sensing-ray edges that fill the occluded/unknown sector.
        self.raycast_viz_topic = str(selector_pubs.get("raycast_viz", "/vertex_selector/raycast_viz"))
        self.line_fit_viz_topic = str(selector_pubs.get("line_fit_viz", "/vertex_selector/line_fit_viz"))
        self.estimated_vertex_motion_topic = str(
            selector_pubs.get("estimated_vertex_motion", "/vertex_selector/estimated_vertex_motion")
        )

        # A LiDAR-only bag may contain no /ego_state; use configured pose
        # until live /ego_state messages arrive.
        self.have_ego = (self.input_source == "velodyne_points")
        self.have_obstacle = False
        self.have_raycast_cloud = False
        self.latest_obstacle_msg = None
        # External raycast fast path: keep the incoming cloud as one contiguous
        # N x 10 float64 buffer. Do not expand it into Python dictionaries.
        self.latest_raycast_rows = np.empty((0, 10), dtype=np.float64)
        self.latest_raycast_observation_stamp = None
        self.raycast_sequence = 0
        self.last_processed_raycast_sequence = -1
        self._external_cpp_cached_result = None
        self._external_cpp_cached_has_geometry = False
        # Timestamp of the newest /obstacle observation.  Motion estimation must
        # advance on the obstacle publisher's clock, not on this selector's loop
        # clock; otherwise a slow /obstacle publisher observed by a fast selector
        # produces velocity spikes (delta_x divided by the selector period).
        self.latest_obstacle_observation_stamp = None
        # Original obstacle shapes translate without changing topology in the
        # current stack.  Cache convex partitions in centered local coordinates
        # so ear clipping is not repeated at the selector publish rate.
        self.partition_cache = {}

        # Fast path: all geometry from ray casting through fitted vertices and
        # convex partitions is handled in a compact C++ kernel. Python keeps ROS
        # I/O, temporal motion estimation, and publication. If the shared library
        # is unavailable or fails, the original Python implementation remains a
        # functional fallback.
        self.use_cpp_vertex_pipeline = _as_bool(rospy.get_param(
            "~use_cpp_vertex_pipeline",
            self.selector_cfg.get("use_cpp_vertex_pipeline", True),
        ), True)
        script_dir = os.path.dirname(os.path.abspath(__file__))
        default_cpp_library = os.path.join(script_dir, "libvertex_selector_fast_motion.so")
        configured_cpp_library = str(rospy.get_param(
            "~cpp_vertex_library",
            self.selector_cfg.get("cpp_vertex_library", ""),
        )).strip()
        self.require_cpp_vertex_pipeline = _as_bool(rospy.get_param(
            "~require_cpp_vertex_pipeline",
            self.selector_cfg.get("require_cpp_vertex_pipeline", True),
        ), True)

        # Prefer the motion-capable library even when an older /setup still points
        # to libvertex_selector_fast.so.  The old filename is kept only as a
        # compatibility candidate.
        cpp_candidates = []
        if configured_cpp_library:
            configured_cpp_library = os.path.abspath(configured_cpp_library)
            configured_dir = os.path.dirname(configured_cpp_library)
            configured_base = os.path.basename(configured_cpp_library)
            if configured_base == "libvertex_selector_fast.so":
                cpp_candidates.append(os.path.join(configured_dir, "libvertex_selector_fast_motion.so"))
            cpp_candidates.append(configured_cpp_library)
        cpp_candidates.append(default_cpp_library)

        deduped_candidates = []
        for candidate in cpp_candidates:
            candidate = os.path.abspath(candidate)
            if candidate not in deduped_candidates:
                deduped_candidates.append(candidate)

        self.cpp_vertex_library = deduped_candidates[0]
        self.cpp_vertex_pipeline = None
        self.cpp_vertex_kernel_ms = 0.0
        cpp_load_errors = []
        if self.use_cpp_vertex_pipeline:
            for candidate in deduped_candidates:
                if not os.path.exists(candidate):
                    cpp_load_errors.append("{}: file not found".format(candidate))
                    continue
                try:
                    pipeline = _CppVertexPipeline(candidate)
                    self.cpp_vertex_pipeline = pipeline
                    self.cpp_vertex_library = candidate
                    rospy.loginfo(
                        "[vertex_selector] C++ vertex+motion pipeline enabled: %s",
                        candidate,
                    )
                    break
                except Exception as exc:
                    cpp_load_errors.append("{}: {}".format(candidate, exc))

            if self.cpp_vertex_pipeline is None:
                detail = " | ".join(cpp_load_errors) if cpp_load_errors else "no C++ library candidate"
                message = "[vertex_selector] failed to load motion-capable C++ pipeline: {}".format(detail)
                if self.require_cpp_vertex_pipeline:
                    rospy.logfatal(message)
                    raise RuntimeError(message)
                rospy.logwarn(message + "; using Python fallback")

        rospy.Subscriber("/tracked_pose", PoseStamped, self.tracked_pose_callback, queue_size=1)
        rospy.Subscriber(ego_state_topic, Ego_state, self.ego_callback, queue_size=1)
        rospy.Subscriber(obstacle_topic, obstacle_polygon, self.obstacle_callback, queue_size=1)
        if self.input_source == "velodyne_points":
            rospy.Subscriber(self.velodyne_points_topic, PointCloud2,
                             self.velodyne_points_callback, queue_size=1, buff_size=2 ** 24)
        elif self.input_source == "raycast_cloud":
            rospy.Subscriber(
                self.raycast_point_cloud_topic, Float64MultiArray,
                self.raycast_point_cloud_callback, queue_size=1,
            )
        self.setup_subscriber = rospy.Subscriber(
            self.setup_topic, Setup, self.setup_callback, queue_size=1
        )

        self.pub_selected_vertex_data = rospy.Publisher(
            self.selected_vertex_data_topic, obstacle_polygon, queue_size=1
        )
        # No odom-geometry publishers: map is the only world/planning frame.
        self.pub_selected_vertex_data_odom = None
        self.pub_percepted_obstacle_odom = None
        self.pub_selected_vertex_horizon_data = rospy.Publisher(
            self.selected_vertex_horizon_data_topic, self._horizon_msg_cls, queue_size=1
        )
        self.pub_percepted_obstacle = rospy.Publisher(
            self.percepted_obstacle_topic, obstacle_polygon, queue_size=1
        )
        self.pub_raycast_viz = rospy.Publisher(
            self.raycast_viz_topic, MarkerArray, queue_size=1
        )
        self.pub_line_fit_viz = rospy.Publisher(
            self.line_fit_viz_topic, MarkerArray, queue_size=1
        )
        self.pub_estimated_vertex_motion = rospy.Publisher(
            self.estimated_vertex_motion_topic, Float64MultiArray, queue_size=1
        )

        rospy.loginfo(
            "[vertex_selector] hz=%.1f, R=%.2f, fov_half_angle=%.1f deg, max_obs=%d, raycast=%s, ray_step=%.2f deg, line_err=%.3f, ego_scaled_local=%s, N=%d, dt=%.3f, horizon_topic=%s",
            float(self.hz), float(self.obs_sensing_R), float(self.obs_fov_deg),
            int(self.max_obs), str(bool(self.use_raycast_shape_estimation)),
            float(self.ray_angle_step_deg), float(self.line_fit_max_error), str(bool(self.use_ego_scaled_local_frame)),
            int(self.horizon_N), float(self.prediction_dt), str(self.selected_vertex_horizon_data_topic),
        )
        rospy.loginfo(
            "[vertex_selector] publish_fast numpy_horizon=%s perceived_hz=%.1f",
            str(bool(self._use_numpy_horizon_msg)), float(self.perceived_obstacle_hz),
        )
        rospy.loginfo(
            "[vertex_selector] external_raycast=%s point_cloud_topic=%s",
            str(bool(self.use_external_raycast)), str(self.raycast_point_cloud_topic),
        )
        rospy.loginfo(
            "[vertex_selector] vertex_tracking=%s match_gate=%.3f m min_move=%.4f m dyn_speed=%.3f m/s vmax=%.2f m/s alpha=%.2f motion_topic=%s",
            str(bool(self.estimate_vertex_velocity)), float(self.vertex_match_max_distance),
            float(self.vertex_motion_min_displacement), float(self.vertex_dynamic_speed_threshold),
            float(self.vertex_velocity_max), float(self.vertex_velocity_alpha),
            str(self.estimated_vertex_motion_topic),
        )

    def setup_callback(self, msg):
        """Keep /setup and apply runtime field_flag-only comparison overrides."""
        try:
            self.raw_setup = setup_msg_to_raw(msg)
            normal_cfg = self.raw_setup.get("normal_cfg", {}) if isinstance(self.raw_setup, dict) else {}
            if isinstance(normal_cfg, dict) and "field_flag" in normal_cfg:
                new_flag = int(round(float(normal_cfg["field_flag"])))
                if new_flag not in (0, 1, 2, 3, 4):
                    raise ValueError("field_flag must be one of 0,1,2,3,4")
                old_flag = int(getattr(self, "field_flag", new_flag))
                if old_flag != new_flag:
                    self.field_flag = new_flag
                    rospy.loginfo(
                        "[vertex_selector] runtime /setup field_flag update: %d -> %d",
                        old_flag, new_flag,
                    )
        except Exception as exc:
            rospy.logerr_throttle(1.0, "[vertex_selector] failed to apply /setup: %s", exc)

    def tracked_pose_callback(self, msg):
        if str(msg.header.frame_id).lstrip("/") != "map":
            return
        p, q = msg.pose.position, msg.pose.orientation
        values = (p.x, p.y, p.z, q.x, q.y, q.z, q.w)
        if not all(math.isfinite(float(v)) for v in values):
            return
        with self.tracked_pose_lock:
            self.latest_tracked_pose = (float(p.x), float(p.y), float(p.z),
                                        float(q.x), float(q.y), float(q.z), float(q.w))

    def ego_callback(self, msg):
        # In LiDAR mode, the cloud timestamped TF is authoritative for ego pose.
        # /ego_state may use a different frame or time and must not overwrite it.
        if self.input_source == "velodyne_points":
            return
        self.ego_x = float(msg.ego_x)
        self.ego_y = float(msg.ego_y)
        if hasattr(msg, "ego_yaw"):
            self.ego_yaw = wrap_to_pi(float(msg.ego_yaw))
        elif hasattr(msg, "ego_vx") and hasattr(msg, "ego_vy"):
            vx = float(msg.ego_vx)
            vy = float(msg.ego_vy)
            if math.hypot(vx, vy) > 1.0e-6:
                self.ego_yaw = math.atan2(vy, vx)
        # ego_L/ego_W remain fixed from /setup.
        self.have_ego = True

    def obstacle_callback(self, msg):
        # Freeze one timestamp per received obstacle observation.  Prefer the
        # publisher-provided header stamp; if an upstream source leaves it at zero,
        # use the callback receipt time once.  Re-processing this same message from
        # the faster selector loop then keeps the exact same observation timestamp.
        obs_stamp = None
        if hasattr(msg, "header") and hasattr(msg.header, "stamp"):
            try:
                stamp_sec = float(msg.header.stamp.to_sec())
                if np.isfinite(stamp_sec) and stamp_sec > 0.0:
                    obs_stamp = rospy.Time.from_sec(stamp_sec)
            except Exception:
                obs_stamp = None
        if obs_stamp is None:
            obs_stamp = rospy.Time.now()

        self.latest_obstacle_msg = msg
        self.latest_obstacle_observation_stamp = obs_stamp
        self.have_obstacle = True

    def velodyne_points_callback(self, msg):
        """PointCloud2 XYZ -> z-filtered XY projection -> ordered 2D range rays.

        Per angular bin, retain the nearest XY return. Empty bins are misses,
        preserving angular discontinuities for the existing C++ hit clustering.
        All final geometry and the ego pose use map at the cloud timestamp.
        """
        if self.cloud_z_max <= self.cloud_z_min:
            rospy.logerr_throttle(5.0, "[vertex_selector] invalid cloud z limits")
            return
        fields = {f.name: f for f in msg.fields}
        if not all(k in fields for k in ("x", "y", "z")):
            rospy.logerr_throttle(5.0, "[vertex_selector] PointCloud2 requires x,y,z")
            return
        datatype_map = {
            PointField.INT8: "i1", PointField.UINT8: "u1",
            PointField.INT16: "i2", PointField.UINT16: "u2",
            PointField.INT32: "i4", PointField.UINT32: "u4",
            PointField.FLOAT32: "f4", PointField.FLOAT64: "f8",
        }
        try:
            endian = ">" if msg.is_bigendian else "<"
            names = ["x", "y", "z"]
            formats = [np.dtype(endian + datatype_map[fields[k].datatype]) for k in names]
            offsets = [int(fields[k].offset) for k in names]
            dtype = np.dtype({"names": names, "formats": formats,
                              "offsets": offsets, "itemsize": int(msg.point_step)})
            if msg.height > 1 and msg.row_step != msg.width * msg.point_step:
                raw = np.ndarray((msg.height, msg.width), dtype=dtype, buffer=msg.data,
                                 strides=(msg.row_step, msg.point_step)).reshape(-1)
            else:
                raw = np.frombuffer(msg.data, dtype=dtype, count=int(msg.width * msg.height))
            xyz = np.column_stack((raw["x"], raw["y"], raw["z"]))
        except (ValueError, TypeError, KeyError) as exc:
            rospy.logerr_throttle(2.0, "[vertex_selector] invalid PointCloud2 layout: %s", exc)
            return

        # Project after filtering by local sensor-frame height, not world height.
        valid = np.isfinite(xyz).all(axis=1)
        valid &= (xyz[:, 2] >= self.cloud_z_min) & (xyz[:, 2] <= self.cloud_z_max)
        xyz = xyz[valid]
        if self.cloud_max_points and len(xyz) > self.cloud_max_points:
            xyz = xyz[::int(math.ceil(float(len(xyz)) / self.cloud_max_points))]

        # Project LiDAR XYZ into map at the *observation timestamp*.
        # Ego and obstacles must use the SAME map coordinates for raycast,
        # line fitting, velocity association, and the MPC.
        sensor_frame = str(msg.header.frame_id).lstrip("/")
        cloud_stamp = msg.header.stamp
        if not sensor_frame or cloud_stamp.to_sec() <= 0.0:
            rospy.logwarn_throttle(2.0, "[vertex_selector] invalid cloud frame/stamp")
            return
        # Project with TF map->sensor_frame at the cloud stamp, exactly as RViz
        # does.  /tracked_pose is NOT map->base_link (it is the Cartographer
        # tracking frame, ~0.13 m ahead of base_link with z=0) and the latest
        # value is not time-aligned with the cloud, so it must not be used here.
        try:
            T = self.tf_buffer.lookup_transform(
                "map", sensor_frame, cloud_stamp, rospy.Duration(0.1)).transform
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                tf2_ros.ExtrapolationException) as exc:
            rospy.logwarn_throttle(2.0, "[vertex_selector] TF map->%s at cloud stamp failed: %s",
                                   sensor_frame, exc)
            return
        t, q = T.translation, T.rotation
        R_sensor = quaternion_matrix([q.x, q.y, q.z, q.w])[:3, :3]
        sensor_origin_3d = np.array([t.x, t.y, t.z], dtype=float)
        sensor_origin = sensor_origin_3d[:2]
        # Ego pose stays sourced from /tracked_pose (unchanged semantics).
        with self.tracked_pose_lock:
            pose = self.latest_tracked_pose
        if pose is not None:
            ex, ey, _ez, qx, qy, qz, qw = pose
            self.ego_x, self.ego_y = ex, ey
            self.ego_yaw = math.atan2(2.0 * (qw * qz + qx * qy), 1.0 - 2.0 * (qy * qy + qz * qz))
        else:
            self.ego_x, self.ego_y = float(t.x), float(t.y)
            self.ego_yaw = math.atan2(float(R_sensor[1, 0]), float(R_sensor[0, 0]))
        self.have_ego = True
        if hasattr(self, "motion_world_rotation"):
            del self.motion_world_rotation
        map_xyz = (R_sensor @ xyz.T).T + sensor_origin_3d
        delta_xy = map_xyz[:, :2] - sensor_origin[None, :]
        dist = np.linalg.norm(delta_xy, axis=1)
        valid = (dist >= self.cloud_min_range) & (dist <= self.obs_sensing_R)
        delta_xy, dist = delta_xy[valid], dist[valid]

        # Angular bins are indexed relative to the LiDAR heading, while their
        # direction vectors and endpoints are stored in map coordinates.
        n_bins = max(1, int(math.ceil(360.0 / self.cloud_angle_step_deg)))
        step = 360.0 / n_bins
        centers_deg = -180.0 + (np.arange(n_bins, dtype=np.float64) + 0.5) * step
        sensor_yaw = math.atan2(float(R_sensor[1, 0]), float(R_sensor[0, 0]))
        azimuth = np.rad2deg(np.arctan2(delta_xy[:, 1], delta_xy[:, 0]) - sensor_yaw)
        azimuth = (azimuth + 180.0) % 360.0 - 180.0
        indices = np.clip(np.floor((azimuth + 180.0) / step).astype(np.int32), 0, n_bins - 1)
        nearest = np.full(n_bins, np.inf, dtype=np.float64)
        np.minimum.at(nearest, indices, dist)
        hit = np.isfinite(nearest)
        is_nearest = dist == nearest[indices]
        selected_idx = np.full(n_bins, len(dist), dtype=np.int64)
        np.minimum.at(selected_idx, indices[is_nearest], np.nonzero(is_nearest)[0])
        world_angle = np.deg2rad(centers_deg) + sensor_yaw
        map_dirs = np.column_stack((np.cos(world_angle), np.sin(world_angle)))
        distances = np.where(hit, nearest, self.obs_sensing_R)
        map_points = sensor_origin[None, :] + distances[:, None] * map_dirs
        if np.any(hit):
            observed_delta = delta_xy[selected_idx[hit]]
            observed_range = np.linalg.norm(observed_delta, axis=1)
            map_dirs[hit] = observed_delta / np.maximum(observed_range[:, None], 1e-12)
            map_points[hit] = sensor_origin[None, :] + observed_delta
            distances[hit] = observed_range
        # IMPORTANT: ~obs_fov_deg belongs to the simulated ego-centric
        # raycaster, NOT the full-azimuth physical Velodyne. Clipping the cloud
        # with that (usually 80-degree) window discards rear/side returns.
        # Keep the entire 360-degree scan by default. Only use a rotating FOV
        # when explicitly configured for a physically limited sensor.
        if self.cloud_fov_deg >= 360.0 - 1e-7:
            fov = np.ones(n_bins, dtype=bool)
        else:
            rel_deg = centers_deg
            fov = np.abs(rel_deg) <= 0.5 * self.cloud_fov_deg + 1e-7
        rows = np.zeros((int(np.count_nonzero(fov)), 10), dtype=np.float64)
        rows[:, 0] = centers_deg[fov]  # relative sensor angular ordering
        rows[:, 1:3] = map_dirs[fov]
        rows[:, 3:5] = map_points[fov]
        rows[:, 5] = distances[fov]
        rows[:, 6] = hit[fov].astype(np.float64)
        rows = np.ascontiguousarray(rows)
        self.latest_raycast_rows = rows
        self.latest_cloud_origin = (float(sensor_origin[0]), float(sensor_origin[1]))
        self.latest_raycast_observation_stamp = cloud_stamp
        self.ray_angle_step_deg = step
        self.raycast_sequence += 1
        self.have_raycast_cloud = True
        rospy.loginfo_throttle(5.0, "[vertex_selector] cloud 3D->2D: %d points, %d hits / %d rays",
                               int(len(xyz)), int(np.count_nonzero(rows[:, 6])), int(len(rows)))

    def raycast_point_cloud_callback(self, msg):
        """Store raycast.py output directly as one contiguous N x 10 C++ input buffer.

        ROS row layout:
          [stamp_sec, rel_deg, x, y, distance, dir_x, dir_y,
           hit, hit_type, vx, vy]

        C++ row layout:
          [rel_deg, dir_x, dir_y, x, y, distance, hit, hit_type, vx, vy]
        """
        cols = 11
        data = np.asarray(getattr(msg, "data", []), dtype=np.float64).reshape(-1)
        if data.size == 0:
            self.latest_raycast_rows = np.empty((0, 10), dtype=np.float64)
            self.latest_raycast_observation_stamp = rospy.Time.now()
            self.raycast_sequence += 1
            self.have_raycast_cloud = True
            return
        if data.size % cols != 0:
            rospy.logerr_throttle(
                1.0,
                "[vertex_selector] invalid raycast point cloud length %d; expected multiple of %d",
                int(data.size), int(cols),
            )
            return

        ros_rows = data.reshape(-1, cols)
        stamp_sec = float(ros_rows[0, 0]) if ros_rows.shape[0] else float(rospy.Time.now().to_sec())
        if not np.isfinite(stamp_sec) or stamp_sec <= 0.0:
            stamp_sec = float(rospy.Time.now().to_sec())

        # One allocation/copy is unavoidable because the ROS column order differs
        # from the C++ ABI. No per-ray Python objects are created.
        cpp_rows = np.empty((ros_rows.shape[0], 10), dtype=np.float64)
        cpp_rows[:, 0] = ros_rows[:, 1]       # rel_deg
        cpp_rows[:, 1:3] = ros_rows[:, 5:7]  # dir_x, dir_y
        cpp_rows[:, 3:5] = ros_rows[:, 2:4]  # endpoint x, y
        cpp_rows[:, 5] = ros_rows[:, 4]       # distance
        cpp_rows[:, 6] = ros_rows[:, 7]       # hit
        cpp_rows[:, 7] = ros_rows[:, 8]       # hit_type
        cpp_rows[:, 8:10] = ros_rows[:, 9:11] # vx, vy

        self.latest_raycast_rows = cpp_rows
        self.latest_raycast_observation_stamp = rospy.Time.from_sec(stamp_sec)
        self.raycast_sequence += 1
        self.have_raycast_cloud = True

    @staticmethod
    def get_frame_id(msg):
        if hasattr(msg, "header") and msg.header.frame_id:
            return msg.header.frame_id
        return "map"

    def point_in_ego_fov(self, x, y):
        points = np.array([[float(x), float(y)]], dtype=float)
        return bool(self.points_in_ego_fov(points)[0])

    def points_in_ego_fov(self, points):
        """Vectorized radius/FOV test without per-point atan2 calls."""
        P = np.asarray(points, dtype=float).reshape(-1, 2)
        if P.shape[0] == 0:
            return np.zeros(0, dtype=bool)
        rel = P - np.array([self.ego_x, self.ego_y], dtype=float).reshape(1, 2)
        dist2 = np.einsum("ij,ij->i", rel, rel)
        radius = max(float(self.obs_sensing_R), 0.0)
        in_radius = dist2 <= radius * radius

        half_angle = min(180.0, max(0.0, float(self.obs_fov_deg)))
        if half_angle >= 180.0:
            return in_radius
        forward = np.array([math.cos(self.ego_yaw), math.sin(self.ego_yaw)], dtype=float)
        forward_projection = np.dot(rel, forward)
        angular_gate = forward_projection >= np.sqrt(dist2) * math.cos(math.radians(half_angle)) - 1.0e-12
        return in_radius & angular_gate

    def obstacle_fov_and_distance(self, vertices):
        V = np.asarray(vertices, dtype=float).reshape(-1, 2)
        if V.shape[0] < 3:
            return False, float("inf")

        next_v = np.roll(V, -1, axis=0)
        midpoints = 0.5 * (V + next_v)
        center = np.mean(V, axis=0)
        fov_points = np.vstack((V, midpoints, center.reshape(1, 2)))
        in_fov = bool(np.any(self.points_in_ego_fov(fov_points)))
        if not in_fov:
            return False, float("inf")

        ego_xy = np.array([self.ego_x, self.ego_y], dtype=float)
        edges = next_v - V
        denom = np.einsum("ij,ij->i", edges, edges)
        numer = np.einsum("ij,ij->i", ego_xy.reshape(1, 2) - V, edges)
        t = np.zeros(V.shape[0], dtype=float)
        valid = denom > 1.0e-12
        t[valid] = np.clip(numer[valid] / denom[valid], 0.0, 1.0)
        closest = V + t[:, None] * edges
        edge_dist = np.linalg.norm(closest - ego_xy.reshape(1, 2), axis=1)
        center_dist = float(np.linalg.norm(center - ego_xy))
        return True, min(center_dist, float(np.min(edge_dist)))

    def obstacle_in_ego_fov(self, vertices):
        return self.obstacle_fov_and_distance(vertices)[0]

    def obstacle_distance_to_ego(self, vertices):
        V = np.asarray(vertices, dtype=float).reshape(-1, 2)
        if V.shape[0] < 3:
            return float("inf")
        next_v = np.roll(V, -1, axis=0)
        ego_xy = np.array([self.ego_x, self.ego_y], dtype=float)
        edges = next_v - V
        denom = np.einsum("ij,ij->i", edges, edges)
        numer = np.einsum("ij,ij->i", ego_xy.reshape(1, 2) - V, edges)
        t = np.zeros(V.shape[0], dtype=float)
        valid = denom > 1.0e-12
        t[valid] = np.clip(numer[valid] / denom[valid], 0.0, 1.0)
        closest = V + t[:, None] * edges
        return min(
            float(np.linalg.norm(np.mean(V, axis=0) - ego_xy)),
            float(np.min(np.linalg.norm(closest - ego_xy.reshape(1, 2), axis=1))),
        )

    def get_obstacle_type(self, obstacle, obs_idx):
        if hasattr(obstacle, "obs_types") and obs_idx < len(obstacle.obs_types):
            return 1 if int(obstacle.obs_types[obs_idx]) == 1 else 0
        vx = float(_safe_get_array(obstacle, "obs_vxs", obs_idx, 0.0))
        vy = float(_safe_get_array(obstacle, "obs_vys", obs_idx, 0.0))
        return 1 if abs(vx) + abs(vy) > 1.0e-12 else 0

    def get_obstacle_polygon_vertices(self, obstacle, obs_idx):
        if obs_idx < 0 or obs_idx >= int(obstacle.obs_cnt):
            return []
        if not hasattr(obstacle, "obs_vertex_counts"):
            return []
        if not hasattr(obstacle, "obs_poly_xs") or not hasattr(obstacle, "obs_poly_ys"):
            return []

        nv_reported = max(0, int(obstacle.obs_vertex_counts[obs_idx]))
        # obs_poly_* is stored with a fixed per-obstacle stride.  Do not impose
        # any additional selector-side vertex limit; only respect the number of
        # slots that physically exist for this obstacle in the ROS message.
        nv = min(nv_reported, int(self.msg_max_vertices))
        if nv_reported > int(self.msg_max_vertices):
            rospy.logwarn_throttle(
                1.0,
                "[vertex_selector] obstacle %d reports %d polygon vertices, but the message layout provides only %d slots/obstacle; increase mpc.msg_max_vertices and the obstacle_polygon message layout to carry all vertices",
                int(obs_idx), int(nv_reported), int(self.msg_max_vertices),
            )
        if nv < 3:
            return []

        vertices = []
        for j in range(nv):
            flat_idx = obs_idx * int(self.msg_max_vertices) + j
            if flat_idx >= len(obstacle.obs_poly_xs) or flat_idx >= len(obstacle.obs_poly_ys):
                break
            x = float(obstacle.obs_poly_xs[flat_idx])
            y = float(obstacle.obs_poly_ys[flat_idx])
            if np.isfinite(x) and np.isfinite(y):
                vertices.append((x, y))
        return vertices if len(vertices) >= 3 else []

    @staticmethod
    def polygon_shape_signature(vertices, decimals=9):
        V = remove_duplicate_polygon_vertices(vertices, 1.0e-10)
        if V.shape[0] < 3:
            return None, np.zeros(2, dtype=float), V
        if signed_polygon_area(V) < 0.0:
            V = np.flipud(V)
        center = np.mean(V, axis=0)
        local = V - center.reshape(1, 2)
        signature = (int(V.shape[0]), tuple(np.round(local.reshape(-1), int(decimals)).tolist()))
        return signature, center, V

    def convex_partitions_for_original_polygon(self, vertices):
        signature, center, V = self.polygon_shape_signature(vertices)
        if signature is None:
            return []

        if not hasattr(self, "partition_cache") or self.partition_cache is None:
            self.partition_cache = {}
        cached_local = self.partition_cache.get(signature, None)
        if cached_local is None:
            partitions = convex_partition_polygon_ear_clipping(V)
            if not partitions:
                return []
            cached_local = [
                np.asarray(part, dtype=float).reshape(-1, 2) - center.reshape(1, 2)
                for part in partitions
            ]
            self.partition_cache[signature] = cached_local

        return [
            np.asarray(part_local, dtype=float).reshape(-1, 2) + center.reshape(1, 2)
            for part_local in cached_local
        ]

    @staticmethod
    def _cross_rows(a, b):
        """2-D cross product for row-wise vectors."""
        a = np.asarray(a, dtype=float)
        b = np.asarray(b, dtype=float)
        return a[..., 0] * b[..., 1] - a[..., 1] * b[..., 0]

    def raycast_visible_obstacles(self, obstacle):
        """Cast rays against world geometry using a vectorized ray-edge kernel.

        Geometry semantics are unchanged from the original implementation: every
        ray keeps only the nearest valid segment intersection inside the sensing
        radius, and world obstacle identity is not propagated into clustering.
        The expensive ray x edge intersection stage is evaluated in NumPy instead
        of a Python loop over rays.
        """
        edge_a = []
        edge_b = []
        edge_types = []
        edge_velocities = []

        max_range = max(0.0, float(self.obs_sensing_R))

        for world_obs_idx in range(max(0, int(obstacle.obs_cnt))):
            vertices = self.get_obstacle_polygon_vertices(obstacle, world_obs_idx)
            if len(vertices) < 3:
                continue

            # Safe coarse rejection: polygons whose nearest boundary point is
            # outside the sensing radius cannot be hit by any finite sensor ray.
            if self.obstacle_distance_to_ego(vertices) > max_range + 1.0e-10:
                continue

            obs_type = self.get_obstacle_type(obstacle, world_obs_idx)
            vx, vy = self.get_obstacle_velocity(obstacle, world_obs_idx)
            velocity = np.array([float(vx), float(vy)], dtype=float)

            V = np.asarray(vertices, dtype=float).reshape(-1, 2)
            Vn = np.roll(V, -1, axis=0)
            seg = Vn - V
            keep = np.linalg.norm(seg, axis=1) > 1.0e-10
            if not np.any(keep):
                continue
            A_keep = V[keep]
            B_keep = Vn[keep]
            edge_a.extend(A_keep)
            edge_b.extend(B_keep)
            edge_types.extend([int(obs_type)] * int(A_keep.shape[0]))
            edge_velocities.extend([velocity.copy() for _ in range(int(A_keep.shape[0]))])

        if not edge_a:
            return []

        A = np.asarray(edge_a, dtype=float).reshape(-1, 2)
        B = np.asarray(edge_b, dtype=float).reshape(-1, 2)
        S = B - A
        edge_types = np.asarray(edge_types, dtype=int).reshape(-1)
        edge_velocities = np.asarray(edge_velocities, dtype=float).reshape(-1, 2)
        origin = np.array([float(self.ego_x), float(self.ego_y)], dtype=float)

        step_deg = max(float(self.ray_angle_step_deg), 0.05)
        ray_deg = np.arange(0.0, 360.0 + 0.5 * step_deg, step_deg, dtype=float)
        ray_deg = ray_deg[ray_deg <= 360.0 + 1.0e-9]
        rel_deg = (ray_deg + 180.0) % 360.0 - 180.0
        rel_deg = np.unique(np.round(rel_deg, 10))

        half_angle = min(180.0, max(0.0, float(self.obs_fov_deg)))
        if half_angle < 180.0:
            rel_deg = rel_deg[np.abs(rel_deg) <= half_angle + 1.0e-10]
        rel_deg.sort()
        if rel_deg.size == 0:
            return []

        theta = float(self.ego_yaw) + np.deg2rad(rel_deg)
        directions = np.column_stack((np.cos(theta), np.sin(theta)))
        AP = A - origin.reshape(1, 2)

        # denom[r,e] = cross(ray_direction[r], edge_vector[e])
        denom = (
            directions[:, 0:1] * S[None, :, 1]
            - directions[:, 1:2] * S[None, :, 0]
        )
        valid_denom = np.abs(denom) > 1.0e-12

        # t numerator depends only on the edge; u numerator depends on ray+edge.
        num_t = AP[:, 0] * S[:, 1] - AP[:, 1] * S[:, 0]
        num_u = (
            AP[None, :, 0] * directions[:, 1:2]
            - AP[None, :, 1] * directions[:, 0:1]
        )

        t = np.full(denom.shape, np.inf, dtype=float)
        u = np.full(denom.shape, np.inf, dtype=float)
        np.divide(num_t[None, :], denom, out=t, where=valid_denom)
        np.divide(num_u, denom, out=u, where=valid_denom)

        valid = (
            valid_denom
            & (t >= -1.0e-10)
            & (t <= max_range + 1.0e-10)
            & (u >= -1.0e-10)
            & (u <= 1.0 + 1.0e-10)
        )
        t_valid = np.where(valid, t, np.inf)
        best_edge = np.argmin(t_valid, axis=1)
        row_idx = np.arange(rel_deg.size, dtype=int)
        best_t = t_valid[row_idx, best_edge]
        hit_mask = np.isfinite(best_t)
        distances = np.where(hit_mask, np.maximum(0.0, best_t), max_range)
        endpoints = origin.reshape(1, 2) + distances[:, None] * directions

        ray_records = []
        zero_velocity = np.zeros(2, dtype=float)
        for r in range(int(rel_deg.size)):
            if bool(hit_mask[r]):
                e = int(best_edge[r])
                hit_type = int(edge_types[e])
                hit_velocity = np.asarray(edge_velocities[e], dtype=float).reshape(2).copy()
                hit = True
            else:
                hit_type = 0
                hit_velocity = zero_velocity.copy()
                hit = False

            ray_records.append({
                "rel_deg": float(rel_deg[r]),
                "direction": directions[r].copy(),
                "endpoint": endpoints[r].copy(),
                "distance": float(distances[r]),
                "hit_type": int(hit_type),
                "hit_velocity": hit_velocity,
                "hit": bool(hit),
            })
        return ray_records

    @staticmethod
    def fit_line_tls(points):
        """2-D TLS line fit using a 2x2 covariance eigensolve instead of SVD."""
        P = np.asarray(points, dtype=float).reshape(-1, 2)
        if P.shape[0] < 2:
            return None
        center = np.mean(P, axis=0)
        centered = P - center.reshape(1, 2)
        try:
            covariance = np.dot(centered.T, centered)
            eigenvalues, eigenvectors = np.linalg.eigh(covariance)
        except np.linalg.LinAlgError:
            return None
        direction = np.asarray(eigenvectors[:, int(np.argmax(eigenvalues))], dtype=float).reshape(2)
        dn = float(np.linalg.norm(direction))
        if dn <= 1.0e-12:
            return None
        direction = direction / dn
        traversal = P[-1] - P[0]
        if float(np.dot(direction, traversal)) < 0.0:
            direction = -direction
        normal = np.array([-direction[1], direction[0]], dtype=float)
        residuals = np.abs(np.dot(centered, normal))
        proj = np.dot(centered, direction)
        p_start = center + float(np.min(proj)) * direction
        p_end = center + float(np.max(proj)) * direction
        return {
            "center": center,
            "direction": direction,
            "normal": normal,
            "start": p_start,
            "end": p_end,
            "max_error": float(np.max(residuals)) if residuals.size else 0.0,
            "rms_error": float(math.sqrt(np.mean(residuals * residuals))) if residuals.size else 0.0,
            "points": P,
        }

    @staticmethod
    def _split_residuals_from_endpoint_line(points):
        P = np.asarray(points, dtype=float).reshape(-1, 2)
        if P.shape[0] < 3:
            return np.zeros(P.shape[0], dtype=float)
        chord = P[-1] - P[0]
        length = float(np.linalg.norm(chord))
        if length <= 1.0e-12:
            center = np.mean(P, axis=0)
            return np.linalg.norm(P - center.reshape(1, 2), axis=1)
        normal = np.array([-chord[1], chord[0]], dtype=float) / length
        return np.abs(np.dot(P - P[0].reshape(1, 2), normal))

    def split_and_fit_lines(self, points, depth=0):
        """Recursive split-and-fit using ray-ordered hit points."""
        P = np.asarray(points, dtype=float).reshape(-1, 2)
        if P.shape[0] < 2:
            return []

        min_pts = max(2, int(self.line_fit_min_points))
        residuals = self._split_residuals_from_endpoint_line(P)
        split_idx = int(np.argmax(residuals)) if residuals.size else 0
        can_split = (
            depth < 12
            and P.shape[0] >= 2 * min_pts - 1
            and float(residuals[split_idx]) > float(self.line_fit_max_error)
            and split_idx >= min_pts - 1
            and (P.shape[0] - split_idx) >= min_pts
        )
        if can_split:
            left = self.split_and_fit_lines(P[:split_idx + 1], depth + 1)
            right = self.split_and_fit_lines(P[split_idx:], depth + 1)
            return left + right

        fit = self.fit_line_tls(P)
        if fit is None:
            return []
        if float(np.linalg.norm(fit["end"] - fit["start"])) < float(self.line_fit_min_length):
            return []

        # Visible obstacle surfaces face the ego.  Resolve the TLS normal sign
        # toward the ego to obtain an outward surface normal.
        ego_xy = np.array([float(self.ego_x), float(self.ego_y)], dtype=float)
        n_out = np.asarray(fit["normal"], dtype=float).reshape(2)
        if float(np.dot(n_out, ego_xy - fit["center"])) < 0.0:
            n_out = -n_out
        fit["normal_out"] = n_out
        return [fit]

    def cluster_raycast_hits(self, hit_records):
        """Create perceived obstacles using raycast continuity only.

        No world/original obstacle index is consulted.  Consecutive hit rays are
        grouped when both their angular spacing and endpoint spacing are
        continuous.  A miss ray naturally creates an angular gap because misses
        are absent from ``hit_records``.

        Consequently:
          * two different world polygons can become one perceived obstacle when
            their visible hit surfaces are continuous; and
          * one world polygon can become multiple perceived obstacles when its
            visible hits are disconnected/occluded.
        """
        if not hit_records:
            return []

        hits = sorted(hit_records, key=lambda item: float(item["rel_deg"]))
        max_angle_gap_deg = max(float(self.ray_angle_step_deg) * 1.6, 0.1)
        clusters = [[hits[0]]]

        for item in hits[1:]:
            prev = clusters[-1][-1]
            angle_gap_deg = abs(float(item["rel_deg"] - prev["rel_deg"]))
            spatial_gap = float(np.linalg.norm(item["endpoint"] - prev["endpoint"]))

            if angle_gap_deg > max_angle_gap_deg or spatial_gap > float(self.ray_cluster_gap):
                clusters.append([item])
            else:
                clusters[-1].append(item)

        # For a 360-deg FOV, -180 and +180 are adjacent directions.  Merge the
        # first/last clusters when they are also spatially continuous.
        half_angle = min(180.0, max(0.0, float(self.obs_fov_deg)))
        if half_angle >= 180.0 and len(clusters) >= 2:
            first = clusters[0]
            last = clusters[-1]
            wrap_gap_deg = (float(first[0]["rel_deg"]) + 360.0) - float(last[-1]["rel_deg"])
            wrap_spatial_gap = float(np.linalg.norm(first[0]["endpoint"] - last[-1]["endpoint"]))
            if wrap_gap_deg <= max_angle_gap_deg and wrap_spatial_gap <= float(self.ray_cluster_gap):
                merged = last + first
                clusters = [merged] + clusters[1:-1]

        return [cluster for cluster in clusters if len(cluster) >= 2]

    @staticmethod
    def raycast_cluster_motion_metadata(cluster):
        """Aggregate type/velocity metadata without using world obstacle IDs."""
        if not cluster:
            return 0, np.zeros(2, dtype=float)

        hit_types = np.asarray([int(item.get("hit_type", 0)) for item in cluster], dtype=int)
        dynamic_mask = hit_types == 1

        # Majority vote is robust to a single boundary ray landing on a neighboring
        # surface.  This metadata does not participate in obstacle association.
        dynamic_count = int(np.count_nonzero(dynamic_mask))
        obs_type = 1 if dynamic_count * 2 >= len(cluster) and dynamic_count > 0 else 0

        if obs_type == 1:
            velocities = np.asarray([
                np.asarray(item.get("hit_velocity", np.zeros(2)), dtype=float).reshape(2)
                for item, is_dynamic in zip(cluster, dynamic_mask)
                if bool(is_dynamic)
            ], dtype=float).reshape(-1, 2)
            velocity = np.median(velocities, axis=0) if velocities.shape[0] > 0 else np.zeros(2, dtype=float)
        else:
            velocity = np.zeros(2, dtype=float)

        if not np.all(np.isfinite(velocity)):
            velocity = np.zeros(2, dtype=float)
        return int(obs_type), np.asarray(velocity, dtype=float).reshape(2)

    @staticmethod
    def line_line_intersection(p1, d1, p2, d2):
        p1 = np.asarray(p1, dtype=float).reshape(2)
        d1 = np.asarray(d1, dtype=float).reshape(2)
        p2 = np.asarray(p2, dtype=float).reshape(2)
        d2 = np.asarray(d2, dtype=float).reshape(2)
        denom = _cross2d(d1, d2)
        if abs(denom) <= 1.0e-10:
            return None
        t = _cross2d(p2 - p1, d2) / denom
        return p1 + float(t) * d1

    def terminal_vertex_on_raycast(self, segment, ray_record, fallback):
        """Intersect a fitted terminal line with its boundary ray.

        The first/last ray of a hit cluster is treated as an additional obstacle
        line.  This makes the visible fitted surface terminate at an explicit
        fitted-line/ray-line corner instead of at a free TLS endpoint.
        """
        fallback = np.asarray(fallback, dtype=float).reshape(2)
        if ray_record is None:
            return fallback

        origin = np.array([float(self.ego_x), float(self.ego_y)], dtype=float)
        ray_dir = np.asarray(ray_record.get("direction", np.zeros(2)), dtype=float).reshape(2)
        ray_norm = float(np.linalg.norm(ray_dir))
        if ray_norm <= 1.0e-12:
            return fallback
        ray_dir = ray_dir / ray_norm

        intersection = self.line_line_intersection(
            segment["start"], segment["direction"], origin, ray_dir
        )
        if intersection is None:
            return fallback

        # The terminal corner must lie on the forward sensing ray and remain
        # close to the actually observed terminal hit.  Otherwise keep the TLS
        # endpoint to avoid a large extrapolation caused by nearly parallel lines.
        ray_t = float(np.dot(intersection - origin, ray_dir))
        if ray_t < -1.0e-8 or ray_t > float(self.obs_sensing_R) + float(self.line_intersection_max_extension):
            return fallback

        hit_point = np.asarray(ray_record.get("endpoint", fallback), dtype=float).reshape(2)
        max_terminal_extension = max(
            float(self.line_intersection_max_extension),
            2.0 * float(self.line_fit_max_error),
            0.05,
        )
        if float(np.linalg.norm(intersection - hit_point)) > max_terminal_extension:
            return fallback
        return np.asarray(intersection, dtype=float).reshape(2)

    def estimated_vertices_from_fitted_lines(self, segments, start_ray=None, end_ray=None):
        """Build visible contour vertices, closing both ends onto boundary rays."""
        if not segments:
            return np.zeros((0, 2), dtype=float)

        start_vertex = self.terminal_vertex_on_raycast(
            segments[0], start_ray, segments[0]["start"]
        )
        end_vertex = self.terminal_vertex_on_raycast(
            segments[-1], end_ray, segments[-1]["end"]
        )

        if len(segments) == 1:
            return remove_duplicate_polygon_vertices(
                np.vstack((start_vertex, end_vertex)), tol=1.0e-6
            )

        vertices = [np.asarray(start_vertex, dtype=float).reshape(2)]
        for i in range(len(segments) - 1):
            s0 = segments[i]
            s1 = segments[i + 1]
            intersection = self.line_line_intersection(
                s0["start"], s0["direction"], s1["start"], s1["direction"]
            )
            if intersection is not None:
                ext0 = float(np.linalg.norm(intersection - s0["end"]))
                ext1 = float(np.linalg.norm(intersection - s1["start"]))
                if max(ext0, ext1) <= float(self.line_intersection_max_extension):
                    join = intersection
                else:
                    join = 0.5 * (np.asarray(s0["end"]) + np.asarray(s1["start"]))
            else:
                join = 0.5 * (np.asarray(s0["end"]) + np.asarray(s1["start"]))
            vertices.append(np.asarray(join, dtype=float).reshape(2))
        vertices.append(np.asarray(end_vertex, dtype=float).reshape(2))
        return remove_duplicate_polygon_vertices(np.asarray(vertices, dtype=float), tol=1.0e-6)

    def terminal_raycast_obstacle_edges(self, vertices, start_ray=None, end_ray=None):
        """Create artificial obstacle edges along the two terminal raycast lines.

        Each edge starts at the fitted terminal corner and extends away from the
        ego to the sensing radius.  The outward normal is selected so that the
        angular sector between the two boundary rays is treated as obstacle side.
        """
        V = np.asarray(vertices, dtype=float).reshape(-1, 2)
        if V.shape[0] < 2 or start_ray is None or end_ray is None:
            return []

        origin = np.array([float(self.ego_x), float(self.ego_y)], dtype=float)
        max_range = max(0.0, float(self.obs_sensing_R))
        edges = []
        for side, corner, ray_record in (
            ("start", V[0], start_ray),
            ("end", V[-1], end_ray),
        ):
            d = np.asarray(ray_record.get("direction", np.zeros(2)), dtype=float).reshape(2)
            dn = float(np.linalg.norm(d))
            if dn <= 1.0e-12:
                continue
            d = d / dn
            far = origin + max_range * d
            if float(np.linalg.norm(far - corner)) <= 1.0e-8:
                continue

            # Rays are ordered by increasing relative angle.  The visible/unknown
            # obstacle sector is CCW from the start ray and CW from the end ray.
            if side == "start":
                n_out = np.array([d[1], -d[0]], dtype=float)
            else:
                n_out = np.array([-d[1], d[0]], dtype=float)

            edges.append({
                "side": side,
                "start": np.asarray(corner, dtype=float).reshape(2),
                "end": np.asarray(far, dtype=float).reshape(2),
                "direction": d,
                "normal_out": n_out,
            })
        return edges

    def collect_selected_vertices_raycast(self, obstacle=None, ray_records=None):
        """Point cloud/raycast records -> fitted obstacle -> field raw vertices.

        The input polygons are used only as world geometry.  Perceived obstacle
        IDs are freshly generated in this function from ray-hit clusters and are
        dense integers ``0, 1, ...`` ordered by nearest hit distance among the
        successfully reconstructed clusters.
        """
        if getattr(self, "cpp_vertex_pipeline", None) is not None:
            try:
                if ray_records is not None or bool(getattr(self, "use_external_raycast", False)):
                    source_rows = (
                        np.asarray(ray_records, dtype=np.float64).reshape(-1, 10)
                        if ray_records is not None
                        else self.latest_raycast_rows
                    )
                    seq = int(getattr(self, "raycast_sequence", 0))
                    need_geometry = bool(getattr(self, "_emit_cpp_python_geometry", False))
                    cache_valid = (
                        self._external_cpp_cached_result is not None
                        and int(getattr(self, "last_processed_raycast_sequence", -1)) == seq
                        and (not need_geometry or bool(getattr(self, "_external_cpp_cached_has_geometry", False)))
                    )
                    if cache_valid:
                        result = self._external_cpp_cached_result
                        self.cpp_vertex_pipeline.last_kernel_ms = 0.0
                        self.cpp_vertex_pipeline.last_motion_ms = 0.0
                    else:
                        result = self.cpp_vertex_pipeline.process_external(self, source_rows)
                        self._external_cpp_cached_result = result
                        self._external_cpp_cached_has_geometry = need_geometry
                        self.last_processed_raycast_sequence = seq
                else:
                    result = self.cpp_vertex_pipeline.process(
                        self, obstacle, emit_rays=bool(getattr(self, "_emit_cpp_ray_records", False))
                    )
                self.cpp_vertex_kernel_ms = float(self.cpp_vertex_pipeline.last_kernel_ms)
                return result
            except Exception as exc:
                if bool(getattr(self, "require_cpp_vertex_pipeline", True)):
                    rospy.logfatal("[vertex_selector] C++ vertex+motion pipeline runtime failure: %s", exc)
                    raise
                rospy.logerr_throttle(
                    1.0,
                    "[vertex_selector] C++ vertex pipeline failed; falling back to Python: %s",
                    exc,
                )

        if ray_records is None:
            if self.use_external_raycast:
                # Python fallback only. Convert the contiguous ray buffer lazily.
                ray_records = _CppVertexPipeline.ray_rows_to_records(self.latest_raycast_rows)
            else:
                ray_records = self.raycast_visible_obstacles(obstacle)
        elif isinstance(ray_records, np.ndarray):
            ray_records = _CppVertexPipeline.ray_rows_to_records(ray_records)
        else:
            ray_records = list(ray_records)
        hit_records = [item for item in ray_records if bool(item["hit"])]

        # IMPORTANT: clustering is global over all hit rays.  There is no
        # source/world obstacle pre-grouping here.
        raw_clusters = self.cluster_raycast_hits(hit_records)
        cluster_candidates = []
        for cluster in raw_clusters:
            nearest_distance = min(float(item["distance"]) for item in cluster)
            cluster_candidates.append((float(nearest_distance), cluster))
        cluster_candidates.sort(key=lambda item: item[0])

        selected = []
        fit_groups = []
        raycast_obstacle_meta = {}
        next_raycast_obs_idx = 0
        next_partition_group_id = 0
        failed_fit_count = 0
        ego_xy = np.array([float(self.ego_x), float(self.ego_y)], dtype=float)

        # Walk candidates from near to far and keep at most max_obs successfully
        # reconstructed raycast obstacles.
        for _nearest_distance, cluster in cluster_candidates:
            if next_raycast_obs_idx >= max(0, int(self.max_obs)):
                break

            cluster_points = np.asarray([item["endpoint"] for item in cluster], dtype=float).reshape(-1, 2)
            segments = self.split_and_fit_lines(cluster_points)
            if not segments:
                failed_fit_count += 1
                continue

            start_ray = cluster[0] if cluster else None
            end_ray = cluster[-1] if cluster else None
            vertices = self.estimated_vertices_from_fitted_lines(
                segments, start_ray=start_ray, end_ray=end_ray
            )
            terminal_ray_edges = self.terminal_raycast_obstacle_edges(
                vertices, start_ray=start_ray, end_ray=end_ray
            )
            # Build a closed perceived polygon from the fitted visible contour
            # and the two terminal sensing-ray edges.  Only ordered polygon
            # vertices are published; C++ constructs edge/pseudo-normal features.
            start_edge = next((e for e in terminal_ray_edges if e.get("side") == "start"), None)
            end_edge = next((e for e in terminal_ray_edges if e.get("side") == "end"), None)
            poly_points = []
            if start_edge is not None:
                poly_points.append(np.asarray(start_edge["end"], dtype=float).reshape(2))
            for vertex in np.asarray(vertices, dtype=float).reshape(-1, 2):
                poly_points.append(np.asarray(vertex, dtype=float).reshape(2))
            if end_edge is not None:
                poly_points.append(np.asarray(end_edge["end"], dtype=float).reshape(2))
            if len(poly_points) < 3:
                poly_points = [p.copy() for p in cluster_points]
            P = remove_duplicate_polygon_vertices(np.asarray(poly_points, dtype=float), tol=1.0e-6)
            if P.shape[0] < 3:
                failed_fit_count += 1
                continue

            # field 0 must build one enclosing circle from the COMPLETE
            # occluded-region-augmented obstacle boundary.  Do not convex-partition
            # or convex-hull this polygon before the circle center/radius are built.
            # Fields 1--4 keep the convex partitions required by their polygon
            # constructions.
            if int(self.field_flag) == 0:
                if signed_polygon_area(P) < 0.0:
                    P = np.flipud(P).copy()
                partitions = [P]
            else:
                partitions = convex_partition_polygon_ear_clipping(P)
            if not partitions:
                failed_fit_count += 1
                continue

            # This is the ONLY obstacle identity used by the raycast perception
            # path.  It is independent of every world polygon index.
            raycast_obs_idx = int(next_raycast_obs_idx)
            next_raycast_obs_idx += 1

            obs_type, velocity = self.raycast_cluster_motion_metadata(cluster)
            raycast_obstacle_meta[raycast_obs_idx] = {
                "obs_type": int(obs_type),
                "velocity": np.asarray(velocity, dtype=float).reshape(2).copy(),
            }

            zero_normal = np.zeros(2, dtype=float)
            first_group_id = None
            for partition_idx, partition_vertices in enumerate(partitions):
                Vp = remove_duplicate_polygon_vertices(partition_vertices, tol=1.0e-10)
                if Vp.shape[0] < 3:
                    continue
                if signed_polygon_area(Vp) < 0.0:
                    Vp = np.flipud(Vp).copy()
                # Keep convex partitions independent in the field, exactly as in
                # polygon mode.  obstacle_ref_idx remains raycast_obs_idx so all
                # partitions share the same motion metadata.
                group_id = int(next_partition_group_id)
                next_partition_group_id += 1
                if first_group_id is None:
                    first_group_id = group_id
                distances = np.linalg.norm(Vp - ego_xy.reshape(1, 2), axis=1)
                for local_idx in range(Vp.shape[0]):
                    selected.append((
                        float(distances[local_idx]),
                        Vp[local_idx].copy(),
                        zero_normal.copy(),
                        int(obs_type),
                        int(raycast_obs_idx),
                        int(group_id),
                        int(local_idx),
                        "polygon_vertex",
                        int(partition_idx),
                    ))

            fit_groups.append({
                "raycast_obs_idx": int(raycast_obs_idx),
                "group_id": int(first_group_id if first_group_id is not None else raycast_obs_idx),
                "obs_type": int(obs_type),
                "velocity": np.asarray(velocity, dtype=float).reshape(2).copy(),
                "segments": segments,
                "vertices": vertices,
                "terminal_ray_edges": terminal_ray_edges,
                "hit_points": cluster_points,
                "hit_records": cluster,
            })

        if self.field_flag == 4:
            selected = _limit_selected_complete_groups(selected, self.F_max, self.N_n)
        perceived_count = len({int(r[4]) for r in selected})
        next_partition_group_id = len({int(r[5]) for r in selected})
        return (
            selected,
            perceived_count,
            int(next_partition_group_id),
            int(failed_fit_count),
            ray_records,
            fit_groups,
            raycast_obstacle_meta,
        )

    @staticmethod
    def _stamp_to_sec(stamp):
        try:
            return float(stamp.to_sec())
        except Exception:
            return float(time.time())

    def _current_ego_pose(self):
        """Return [x, y, yaw] for the selector sample used by raycasting."""
        return np.array([
            float(self.ego_x),
            float(self.ego_y),
            float(self.ego_yaw),
        ], dtype=float)

    def _stationary_terminal_reference(self, current_xy, previous_segments):
        """Predict a terminal fitted vertex under *ego motion only*.

        The first/last fitted vertices are intersections between a visible fitted
        obstacle surface and a sensing ray.  Even for a static obstacle, those
        intersections can slide along the same surface when the ego translates or
        rotates.  To remove that viewpoint-induced motion, cast the CURRENT ray
        (current ego -> current terminal vertex) onto the PREVIOUS fitted surface.

        The returned point is where the current sensing ray would have intersected
        the previous-frame surface if that surface had remained stationary in the
        world.  ``None`` means that no geometrically reasonable previous surface
        intersection was found.
        """
        current_xy = np.asarray(current_xy, dtype=float).reshape(2)
        origin = np.array([float(self.ego_x), float(self.ego_y)], dtype=float)
        ray = current_xy - origin
        ray_norm = float(np.linalg.norm(ray))
        if ray_norm <= 1.0e-10:
            return None
        ray_dir = ray / ray_norm

        best_point = None
        best_error = float("inf")
        max_extension = max(
            float(self.line_intersection_max_extension),
            float(self.vertex_match_max_distance),
        )

        for seg in previous_segments or []:
            p0 = np.asarray(seg.get("start", np.zeros(2)), dtype=float).reshape(2)
            p1 = np.asarray(seg.get("end", p0), dtype=float).reshape(2)
            d = np.asarray(seg.get("direction", p1 - p0), dtype=float).reshape(2)
            dn = float(np.linalg.norm(d))
            if dn <= 1.0e-10:
                continue
            d = d / dn

            intersection = self.line_line_intersection(origin, ray_dir, p0, d)
            if intersection is None or not np.all(np.isfinite(intersection)):
                continue

            # Must lie on the forward current sensing ray.
            ray_t = float(np.dot(intersection - origin, ray_dir))
            if ray_t < -1.0e-8 or ray_t > float(self.obs_sensing_R) + max_extension:
                continue

            # Prefer the finite previous fitted segment, but allow a small line
            # extension because TLS endpoints themselves change with ray sampling.
            seg_len = float(np.linalg.norm(p1 - p0))
            along = float(np.dot(intersection - p0, d))
            if along < -max_extension or along > seg_len + max_extension:
                continue

            error = float(np.linalg.norm(current_xy - intersection))
            if error < best_error:
                best_error = error
                best_point = np.asarray(intersection, dtype=float).reshape(2).copy()

        if best_point is None:
            return None
        if best_error > float(self.vertex_match_max_distance):
            return None
        return best_point

    def estimate_fitted_vertex_motion(self, fit_groups, stamp, raycast_obstacle_meta=None):
        """Fast obstacle-level velocity estimation from fitted raycast vertices.

        The original implementation compared every current obstacle with every
        previous obstacle using full vertex-to-vertex distance matrices and, when
        the ego moved, repeatedly reprojected terminal vertices against every
        previous fitted segment.  That is robust but unnecessarily expensive.

        Fast path used here:
          1) build one robust center per reconstructed obstacle;
          2) if the /obstacle observation timestamp is unchanged, associate only
             by those centers and hold the previous obstacle velocity;
          3) for a genuinely new observation, use center distance only to shortlist
             at most three previous groups, then apply the original vertex-based
             association score only to those shortlisted pairs;
          4) perform vertex matching and ego-viewpoint compensation only inside the
             final matched obstacle pairs.

        This keeps the original obstacle-level median/MAD velocity fusion while
        removing the O(N_group^2 * N_vertex^2 * N_segment) hot path.
        """
        raycast_obstacle_meta = raycast_obstacle_meta if raycast_obstacle_meta is not None else {}
        now_sec = self._stamp_to_sec(stamp)
        previous_groups = list(getattr(self, "previous_obstacle_tracks", []) or [])
        previous_stamp = getattr(self, "previous_fitted_vertex_stamp", None)
        dt = float(now_sec - previous_stamp) if previous_stamp is not None else float("nan")
        dt_valid = np.isfinite(dt) and dt > 1.0e-6 and dt <= float(self.vertex_track_max_dt)
        same_observation = bool(
            previous_stamp is not None
            and np.isfinite(dt)
            and abs(dt) <= 1.0e-6
        )

        current_ego_pose = self._current_ego_pose()
        previous_ego_pose = getattr(self, "previous_fitted_vertex_ego_pose", None)
        ego_translation = 0.0
        ego_yaw_change = 0.0
        ego_motion_valid = False
        if previous_ego_pose is not None:
            previous_ego_pose = np.asarray(previous_ego_pose, dtype=float).reshape(3)
            if np.all(np.isfinite(previous_ego_pose)) and np.all(np.isfinite(current_ego_pose)):
                ego_translation = float(np.linalg.norm(current_ego_pose[:2] - previous_ego_pose[:2]))
                ego_yaw_change = float(wrap_to_pi(current_ego_pose[2] - previous_ego_pose[2]))
                ego_motion_valid = True
        ego_viewpoint_changed = bool(
            ego_motion_valid
            and (ego_translation > 1.0e-6 or abs(ego_yaw_change) > 1.0e-6)
        )

        def robust_center(vertices):
            V = np.asarray(vertices, dtype=float).reshape(-1, 2)
            if V.shape[0] == 0:
                return np.array([np.nan, np.nan], dtype=float)
            # Median is less sensitive than the mean to a terminal vertex sliding
            # along a fitted line as the ego viewpoint changes.
            return np.median(V, axis=0)

        # ------------------------------------------------------------------
        # Build compact current groups and debug records.
        # ------------------------------------------------------------------
        current_groups = []
        records = []
        for group_index, group in enumerate(fit_groups or []):
            V = np.asarray(group.get("vertices", np.zeros((0, 2))), dtype=float).reshape(-1, 2)
            obs_idx = int(group.get("raycast_obs_idx", group_index))
            group_records = []
            for vertex_index, xy in enumerate(V):
                rec = {
                    "group_index": int(group_index),
                    "raycast_obs_idx": int(obs_idx),
                    "vertex_index": int(vertex_index),
                    "current_xy": np.asarray(xy, dtype=float).reshape(2).copy(),
                    "previous_xy": np.array([np.nan, np.nan], dtype=float),
                    "delta": np.zeros(2, dtype=float),
                    "displacement": 0.0,
                    "dt": float(dt) if np.isfinite(dt) else 0.0,
                    "measurement_velocity": np.zeros(2, dtype=float),
                    "velocity": np.zeros(2, dtype=float),
                    "speed": 0.0,
                    "matched": False,
                    "valid": False,
                    "moving": False,
                    "previous_index": -1,
                    "previous_group_index": -1,
                    "ego_motion_compensated": False,
                    "stationary_reference_xy": np.array([np.nan, np.nan], dtype=float),
                }
                group_records.append(rec)
                records.append(rec)
            current_groups.append({
                "group_index": int(group_index),
                "raycast_obs_idx": int(obs_idx),
                "vertices": V,
                "center": robust_center(V),
                "records": group_records,
                "matched_previous_group": -1,
            })
            group["vertex_motion"] = group_records

        # Cache previous centers once.  Old state written by the pre-patch version
        # may not contain a center, so compute it lazily from its stored vertices.
        previous_centers = []
        for prev in previous_groups:
            c = prev.get("center", None)
            if c is None:
                c = robust_center(prev.get("vertices", np.zeros((0, 2))))
            else:
                c = np.asarray(c, dtype=float).reshape(2)
            previous_centers.append(c)

        # ------------------------------------------------------------------
        # 1) Obstacle-group association.
        # ------------------------------------------------------------------
        group_matches = {}
        gate = float(self.vertex_match_max_distance)
        group_gate = max(2.0 * gate, gate + 0.10)
        if (
            bool(self.estimate_vertex_velocity)
            and (dt_valid or same_observation)
            and current_groups
            and previous_groups
        ):
            Ccent = np.asarray([g["center"] for g in current_groups], dtype=float).reshape(-1, 2)
            Pcent = np.asarray(previous_centers, dtype=float).reshape(-1, 2)
            center_dist = np.linalg.norm(Ccent[:, None, :] - Pcent[None, :, :], axis=2)

            if same_observation:
                # Critical fast path: the sensor frame is unchanged, so there is no
                # new velocity information to estimate.  Match only at obstacle level
                # and hold the previous velocity.  No vertex matrices/reprojection.
                candidate_idx = np.argwhere(center_dist <= group_gate)
                if candidate_idx.size:
                    candidate_cost = center_dist[candidate_idx[:, 0], candidate_idx[:, 1]]
                    order = np.argsort(candidate_cost)
                    used_current = set()
                    used_previous = set()
                    for oi in order:
                        ci = int(candidate_idx[int(oi), 0])
                        pi = int(candidate_idx[int(oi), 1])
                        if ci in used_current or pi in used_previous:
                            continue
                        used_current.add(ci)
                        used_previous.add(pi)
                        group_matches[ci] = pi
                        current_groups[ci]["matched_previous_group"] = pi
            else:
                # Shortlist only a few plausible previous groups by robust center.
                # The original vertex-based median score is then evaluated only on
                # these pairs instead of every current x previous combination.
                pair_candidates = []
                shortlist_k = min(3, len(previous_groups))
                for ci, cur in enumerate(current_groups):
                    if shortlist_k <= 0:
                        break
                    nearest_prev = np.argsort(center_dist[ci])[:shortlist_k]
                    C = cur["vertices"]
                    if C.shape[0] == 0:
                        continue
                    for pi_raw in nearest_prev:
                        pi = int(pi_raw)
                        if float(center_dist[ci, pi]) > group_gate:
                            continue
                        P = np.asarray(previous_groups[pi].get("vertices", np.zeros((0, 2))), dtype=float).reshape(-1, 2)
                        if P.shape[0] == 0:
                            continue
                        distances = np.linalg.norm(C[:, None, :] - P[None, :, :], axis=2)
                        nearest_each_current = np.min(distances, axis=1)

                        # Keep the original terminal-viewpoint correction, but only
                        # for shortlisted group pairs (at most 3 per current group).
                        if ego_viewpoint_changed and C.shape[0] >= 1:
                            prev_segments = previous_groups[pi].get("segments", []) or []
                            for vi in {0, int(C.shape[0] - 1)}:
                                static_ref = self._stationary_terminal_reference(C[vi], prev_segments)
                                if static_ref is not None:
                                    nearest_each_current[vi] = float(np.linalg.norm(C[vi] - static_ref))

                        cost = float(np.median(nearest_each_current))
                        min_distance = float(np.min(nearest_each_current))
                        if min_distance <= gate and cost <= gate:
                            pair_candidates.append((cost, min_distance, ci, pi))

                pair_candidates.sort(key=lambda x: (x[0], x[1]))
                used_current = set()
                used_previous = set()
                for _cost, _min_distance, ci, pi in pair_candidates:
                    if ci in used_current or pi in used_previous:
                        continue
                    used_current.add(ci)
                    used_previous.add(pi)
                    group_matches[int(ci)] = int(pi)
                    current_groups[ci]["matched_previous_group"] = int(pi)

        # ------------------------------------------------------------------
        # 2) Per-matched-group vertex motion and robust obstacle velocity fusion.
        # ------------------------------------------------------------------
        for ci, cur in enumerate(current_groups):
            group_index = int(cur["group_index"])
            group = fit_groups[group_index]
            group_records = cur["records"]
            obs_idx = int(cur["raycast_obs_idx"])
            obstacle_velocity = np.zeros(2, dtype=float)
            obstacle_velocity_valid = False
            obstacle_displacement = 0.0
            previous_velocity = np.zeros(2, dtype=float)

            pi = group_matches.get(int(ci), None)
            if pi is not None:
                prev_group = previous_groups[int(pi)]
                previous_velocity = np.asarray(
                    prev_group.get("velocity", np.zeros(2)), dtype=float
                ).reshape(2)
                if not np.all(np.isfinite(previous_velocity)):
                    previous_velocity[:] = 0.0

                if same_observation:
                    obstacle_velocity = previous_velocity.copy()
                    obstacle_speed_held = float(np.linalg.norm(obstacle_velocity))
                    obstacle_velocity_valid = bool(
                        np.all(np.isfinite(obstacle_velocity))
                        and obstacle_speed_held <= float(self.vertex_velocity_max)
                    )
                    if not obstacle_velocity_valid:
                        obstacle_velocity[:] = 0.0
                elif dt_valid:
                    C = cur["vertices"]
                    P = np.asarray(prev_group.get("vertices", np.zeros((0, 2))), dtype=float).reshape(-1, 2)
                    if C.shape[0] > 0 and P.shape[0] > 0:
                        distances = np.linalg.norm(C[:, None, :] - P[None, :, :], axis=2)
                        used_current = set()
                        used_previous = set()
                        raw_velocity_rows = []
                        valid_displacements = []

                        # Terminal vertices are ray/surface intersections.  Correct
                        # them against the previous fitted surface before ordinary
                        # nearest-vertex matching.
                        if ego_viewpoint_changed:
                            prev_segments = prev_group.get("segments", []) or []
                            for vi in sorted({0, int(C.shape[0] - 1)}):
                                static_ref = self._stationary_terminal_reference(C[vi], prev_segments)
                                if static_ref is None:
                                    continue
                                delta = C[vi] - static_ref
                                distance = float(np.linalg.norm(delta))
                                if distance > gate:
                                    continue
                                rec = group_records[int(vi)]
                                rec["matched"] = True
                                rec["previous_index"] = -2
                                rec["previous_group_index"] = int(pi)
                                rec["previous_xy"] = static_ref.copy()
                                rec["stationary_reference_xy"] = static_ref.copy()
                                rec["delta"] = delta.copy()
                                rec["displacement"] = distance
                                rec["ego_motion_compensated"] = True
                                used_current.add(int(vi))

                                raw_speed = distance / dt
                                if np.isfinite(raw_speed) and raw_speed <= float(self.vertex_velocity_max):
                                    raw_velocity = delta / dt
                                    if np.all(np.isfinite(raw_velocity)):
                                        rec["measurement_velocity"] = raw_velocity.copy()
                                        raw_velocity_rows.append(raw_velocity.copy())
                                        valid_displacements.append(distance)

                        # Only enumerate vertex pairs that are actually inside the
                        # matching gate.  This avoids sorting the entire C x P matrix.
                        pair_idx = np.argwhere(distances <= gate)
                        if pair_idx.size:
                            pair_dist = distances[pair_idx[:, 0], pair_idx[:, 1]]
                            pair_order = np.argsort(pair_dist)
                            for oi in pair_order:
                                vi = int(pair_idx[int(oi), 0])
                                pvi = int(pair_idx[int(oi), 1])
                                if vi in used_current or pvi in used_previous:
                                    continue
                                used_current.add(vi)
                                used_previous.add(pvi)
                                distance = float(distances[vi, pvi])
                                rec = group_records[vi]
                                prev_xy = P[pvi].copy()
                                delta = C[vi] - prev_xy
                                rec["matched"] = True
                                rec["previous_index"] = pvi
                                rec["previous_group_index"] = int(pi)
                                rec["previous_xy"] = prev_xy
                                rec["delta"] = delta.copy()
                                rec["displacement"] = distance

                                raw_speed = distance / dt
                                if not np.isfinite(raw_speed) or raw_speed > float(self.vertex_velocity_max):
                                    continue
                                raw_velocity = delta / dt
                                if not np.all(np.isfinite(raw_velocity)):
                                    continue
                                rec["measurement_velocity"] = raw_velocity.copy()
                                raw_velocity_rows.append(raw_velocity.copy())
                                valid_displacements.append(distance)

                        if raw_velocity_rows:
                            Vraw = np.asarray(raw_velocity_rows, dtype=float).reshape(-1, 2)
                            center_velocity = np.median(Vraw, axis=0)
                            residual = np.linalg.norm(Vraw - center_velocity.reshape(1, 2), axis=1)
                            residual_median = float(np.median(residual))
                            mad = float(np.median(np.abs(residual - residual_median)))
                            all_displacements = np.asarray(valid_displacements, dtype=float)
                            if Vraw.shape[0] >= 3 and mad > 1.0e-9:
                                robust_sigma = 1.4826 * mad
                                keep = residual <= residual_median + 3.0 * robust_sigma
                                if np.any(keep):
                                    Vused = Vraw[keep]
                                    used_displacements = all_displacements[keep]
                                else:
                                    Vused = Vraw
                                    used_displacements = all_displacements
                            else:
                                Vused = Vraw
                                used_displacements = all_displacements

                            measured_velocity = np.median(Vused, axis=0)
                            obstacle_displacement = float(np.median(used_displacements))
                            if obstacle_displacement < float(self.vertex_motion_min_displacement):
                                obstacle_velocity = np.zeros(2, dtype=float)
                            else:
                                alpha = float(self.vertex_velocity_alpha)
                                obstacle_velocity = alpha * measured_velocity + (1.0 - alpha) * previous_velocity

                            obstacle_speed_tmp = float(np.linalg.norm(obstacle_velocity))
                            obstacle_velocity_valid = bool(
                                np.all(np.isfinite(obstacle_velocity))
                                and obstacle_speed_tmp <= float(self.vertex_velocity_max)
                            )
                            if not obstacle_velocity_valid:
                                obstacle_velocity[:] = 0.0

            obstacle_speed = float(np.linalg.norm(obstacle_velocity))
            # Require five consecutive, distinct matched observations above threshold.
            if pi is not None and (same_observation or dt_valid):
                moving_history = list(previous_groups[int(pi)].get("moving_history", []))
            else:
                moving_history = []
            if not same_observation:
                moving_history.append(bool(
                    obstacle_velocity_valid and obstacle_speed >= float(self.vertex_dynamic_speed_threshold)
                ))
                moving_history = moving_history[-2:]
            moving = len(moving_history) == 2 and all(moving_history)
            group["moving_history"] = moving_history
            motion_type = 1 if moving else 0

            for rec in group_records:
                rec["velocity"] = obstacle_velocity.copy()
                rec["speed"] = obstacle_speed
                rec["valid"] = bool(obstacle_velocity_valid)
                rec["moving"] = bool(moving)

            group["vertex_motion"] = group_records
            group["velocity"] = obstacle_velocity.copy()
            group["obs_type"] = int(motion_type)
            group["estimated_speed"] = obstacle_speed
            group["estimated_displacement"] = float(obstacle_displacement)
            group["velocity_valid"] = bool(obstacle_velocity_valid)

            meta = raycast_obstacle_meta.setdefault(obs_idx, {})
            meta["velocity"] = obstacle_velocity.copy()
            meta["obs_type"] = int(motion_type)
            meta["estimated_speed"] = obstacle_speed
            meta["estimated_displacement"] = float(obstacle_displacement)
            meta["velocity_valid"] = bool(obstacle_velocity_valid)
            meta["velocity_source"] = (
                "held_previous_observation" if same_observation else
                ("obstacle_vertex_fusion_ego_compensated" if ego_viewpoint_changed else "obstacle_vertex_fusion")
            )

        # Save only compact obstacle state for the next observation.
        next_previous_groups = []
        for ci, cur in enumerate(current_groups):
            group = fit_groups[int(cur["group_index"])]
            stored_segments = []
            for seg in group.get("segments", []) or []:
                stored_segments.append({
                    "start": np.asarray(seg.get("start", np.zeros(2)), dtype=float).reshape(2).copy(),
                    "end": np.asarray(seg.get("end", np.zeros(2)), dtype=float).reshape(2).copy(),
                    "direction": np.asarray(seg.get("direction", np.zeros(2)), dtype=float).reshape(2).copy(),
                })
            next_previous_groups.append({
                "vertices": np.asarray(cur["vertices"], dtype=float).reshape(-1, 2).copy(),
                "center": np.asarray(cur["center"], dtype=float).reshape(2).copy(),
                "segments": stored_segments,
                "velocity": np.asarray(group.get("velocity", np.zeros(2)), dtype=float).reshape(2).copy(),
                "raycast_obs_idx": int(cur["raycast_obs_idx"]),
                "moving_history": list(group.get("moving_history", [])),
            })
        self.previous_obstacle_tracks = next_previous_groups
        self.previous_fitted_vertex_stamp = float(now_sec)
        self.previous_fitted_vertex_ego_pose = current_ego_pose.copy()
        return records, raycast_obstacle_meta

    @staticmethod
    def apply_raycast_motion_meta_to_selected(selected, raycast_obstacle_meta):
        """Make selected vertex type consistent with temporal motion metadata."""
        if not selected or not raycast_obstacle_meta:
            return selected
        updated = []
        for item in selected:
            values = list(item)
            obs_idx = int(values[4])
            meta = raycast_obstacle_meta.get(obs_idx, None)
            if meta is not None and "obs_type" in meta:
                values[3] = int(meta["obs_type"])
            updated.append(tuple(values))
        return updated

    def publish_estimated_vertex_motion(self, records):
        """Publish one row per fitted vertex for debugging/inspection.

        Row fields:
          [obs_idx, vertex_idx, cur_x, cur_y, prev_x, prev_y, dx, dy,
           displacement, dt, obs_vx, obs_vy, obs_speed, matched, valid, moving]

        ``obs_vx/obs_vy`` are obstacle-level fused velocities and therefore are
        identical for all vertices belonging to the same perceived obstacle.
        """
        rows = []
        for rec in records or []:
            cur = np.asarray(rec["current_xy"], dtype=float).reshape(2)
            prev = np.asarray(rec["previous_xy"], dtype=float).reshape(2)
            delta = np.asarray(rec["delta"], dtype=float).reshape(2)
            vel = np.asarray(rec["velocity"], dtype=float).reshape(2)
            rows.append([
                float(rec["raycast_obs_idx"]),
                float(rec["vertex_index"]),
                float(cur[0]), float(cur[1]),
                float(prev[0]), float(prev[1]),
                float(delta[0]), float(delta[1]),
                float(rec["displacement"]), float(rec["dt"]),
                float(vel[0]), float(vel[1]), float(rec["speed"]),
                1.0 if bool(rec["matched"]) else 0.0,
                1.0 if bool(rec["valid"]) else 0.0,
                1.0 if bool(rec["moving"]) else 0.0,
            ])

        data = np.asarray(rows, dtype=np.float64).reshape(-1, 16) if rows else np.zeros((0, 16), dtype=np.float64)
        msg = Float64MultiArray()
        msg.layout.dim = [
            MultiArrayDimension(label="vertex", size=int(data.shape[0]), stride=int(data.shape[0] * 16)),
            MultiArrayDimension(label="field", size=16, stride=16),
        ]
        msg.layout.data_offset = 0
        msg.data = data.reshape(-1).tolist()
        self.pub_estimated_vertex_motion.publish(msg)

    @staticmethod
    def _ros_point(xy, z=0.0):
        p = Point()
        p.x = float(xy[0])
        p.y = float(xy[1])
        p.z = float(z)
        return p

    @staticmethod
    def _init_marker(frame_id, stamp, ns, marker_id, marker_type, scale_x, scale_y=None, scale_z=None):
        marker = Marker()
        marker.header.frame_id = str(frame_id)
        marker.header.stamp = stamp
        marker.ns = str(ns)
        marker.id = int(marker_id)
        marker.type = int(marker_type)
        marker.action = Marker.ADD
        marker.pose.orientation.w = 1.0
        marker.scale.x = float(scale_x)
        marker.scale.y = float(scale_y if scale_y is not None else scale_x)
        marker.scale.z = float(scale_z if scale_z is not None else scale_x)
        marker.color.a = 0.9
        marker.lifetime = rospy.Duration(0.2)
        return marker


    def _publish_world_markers(self, pub, markers):
        """Publish geometry already computed in map without another transform."""
        for marker in markers.markers:
            marker.header.frame_id = self.frame_id
        pub.publish(markers)


    def publish_raycast_visualization(self, ray_records, frame_id, stamp):
        if not bool(self.publish_raycast_viz):
            return
        origin = np.array([float(self.ego_x), float(self.ego_y)], dtype=float)
        hit_rays = self._init_marker(frame_id, stamp, "raycast_hit_rays", 0, Marker.LINE_LIST, 0.012)
        hit_rays.color.r = 0.1
        hit_rays.color.g = 0.9
        hit_rays.color.b = 0.2
        miss_rays = self._init_marker(frame_id, stamp, "raycast_miss_rays", 1, Marker.LINE_LIST, 0.006)
        miss_rays.color.r = 0.55
        miss_rays.color.g = 0.55
        miss_rays.color.b = 0.55
        miss_rays.color.a = 0.25
        hit_points = self._init_marker(frame_id, stamp, "raycast_hit_points", 2, Marker.POINTS, 0.045, 0.045, 0.045)
        hit_points.color.r = 1.0
        hit_points.color.g = 0.2
        hit_points.color.b = 0.1

        origin_point = self._ros_point(origin, 0.03)
        for item in ray_records:
            endpoint = self._ros_point(item["endpoint"], 0.03)
            if bool(item["hit"]):
                hit_rays.points.append(origin_point)
                hit_rays.points.append(endpoint)
                hit_points.points.append(endpoint)
            else:
                miss_rays.points.append(origin_point)
                miss_rays.points.append(endpoint)

        msg = MarkerArray()
        msg.markers = [miss_rays, hit_rays, hit_points]
        self._publish_world_markers(self.pub_raycast_viz, msg)

    def publish_line_fit_visualization(self, fit_groups, selected, frame_id, stamp):
        if not bool(self.publish_line_fit_viz):
            return
        line_marker = self._init_marker(frame_id, stamp, "fitted_lines", 0, Marker.LINE_LIST, 0.035)
        line_marker.color.r = 0.1
        line_marker.color.g = 0.45
        line_marker.color.b = 1.0
        vertex_marker = self._init_marker(frame_id, stamp, "estimated_vertices", 1, Marker.SPHERE_LIST, 0.09, 0.09, 0.09)
        vertex_marker.color.r = 1.0
        vertex_marker.color.g = 0.75
        vertex_marker.color.b = 0.05
        selected_marker = self._init_marker(frame_id, stamp, "selected_fit_features", 2, Marker.POINTS, 0.055, 0.055, 0.055)
        selected_marker.color.r = 0.85
        selected_marker.color.g = 0.1
        selected_marker.color.b = 0.9
        boundary_marker = self._init_marker(frame_id, stamp, "terminal_raycast_obstacle_edges", 3, Marker.LINE_LIST, 0.04)
        boundary_marker.color.r = 1.0
        boundary_marker.color.g = 0.35
        boundary_marker.color.b = 0.05
        boundary_vertex_marker = self._init_marker(frame_id, stamp, "terminal_raycast_vertices", 4, Marker.SPHERE_LIST, 0.075, 0.075, 0.075)
        boundary_vertex_marker.color.r = 0.95
        boundary_vertex_marker.color.g = 0.15
        boundary_vertex_marker.color.b = 0.15
        match_marker = self._init_marker(frame_id, stamp, "vertex_temporal_matches", 5, Marker.LINE_LIST, 0.018)
        match_marker.color.r = 0.15
        match_marker.color.g = 0.95
        match_marker.color.b = 0.95
        velocity_marker = self._init_marker(frame_id, stamp, "vertex_estimated_velocity", 6, Marker.LINE_LIST, 0.025)
        velocity_marker.color.r = 0.15
        velocity_marker.color.g = 1.0
        velocity_marker.color.b = 0.25

        for group in fit_groups:
            for seg in group["segments"]:
                line_marker.points.append(self._ros_point(seg["start"], 0.06))
                line_marker.points.append(self._ros_point(seg["end"], 0.06))
            for vertex in np.asarray(group["vertices"], dtype=float).reshape(-1, 2):
                vertex_marker.points.append(self._ros_point(vertex, 0.08))
            for edge in group.get("terminal_ray_edges", []):
                boundary_marker.points.append(self._ros_point(edge["start"], 0.065))
                boundary_marker.points.append(self._ros_point(edge["end"], 0.065))
                boundary_vertex_marker.points.append(self._ros_point(edge["end"], 0.085))
            for rec in group.get("vertex_motion", []) or []:
                current_xy = np.asarray(rec.get("current_xy", np.zeros(2)), dtype=float).reshape(2)
                if bool(rec.get("matched", False)) and np.all(np.isfinite(rec.get("previous_xy", np.zeros(2)))):
                    previous_xy = np.asarray(rec["previous_xy"], dtype=float).reshape(2)
                    match_marker.points.append(self._ros_point(previous_xy, 0.115))
                    match_marker.points.append(self._ros_point(current_xy, 0.115))
                if bool(rec.get("valid", False)):
                    velocity = np.asarray(rec.get("velocity", np.zeros(2)), dtype=float).reshape(2)
                    velocity_marker.points.append(self._ros_point(current_xy, 0.125))
                    velocity_marker.points.append(self._ros_point(current_xy + 0.35 * velocity, 0.125))
        for item in selected:
            selected_marker.points.append(self._ros_point(item[1], 0.10))

        msg = MarkerArray()
        msg.markers = [
            line_marker, boundary_marker, vertex_marker, boundary_vertex_marker,
            selected_marker, match_marker, velocity_marker,
        ]
        self._publish_world_markers(self.pub_line_fit_viz, msg)

    def collect_selected_vertices(self, obstacle):
        """Select obstacles and emit field-specific ordered raw boundary vertices.

        The selector no longer constructs edge normals or pseudo-vertex normals.
        Those features are generated from these ordered polygon vertices by the
        C++ helper called from utils_linearized.py.
        """
        # max_obs is the only selector-side obstacle-count budget.  Inspect all
        # obstacles carried by the incoming message, apply the FOV/radius gate,
        # sort by distance, and only then keep the nearest max_obs obstacles.
        obs_cnt = max(0, int(obstacle.obs_cnt))
        ego_xy = np.array([float(self.ego_x), float(self.ego_y)], dtype=float)
        fov_obstacles = []

        for source_obs_idx in range(obs_cnt):
            vertices = self.get_obstacle_polygon_vertices(obstacle, source_obs_idx)
            if len(vertices) < 3:
                continue
            in_fov, dist = self.obstacle_fov_and_distance(vertices)
            if in_fov:
                fov_obstacles.append((float(dist), int(source_obs_idx), vertices))

        fov_obstacles.sort(key=lambda item: item[0])
        selected_sources = fov_obstacles[:max(0, int(self.max_obs))]

        selected = []
        next_partition_group_id = 0
        failed_partition_count = 0
        zero_normal = np.zeros(2, dtype=float)
        for _obs_dist, source_obs_idx, source_vertices in selected_sources:
            V_source = remove_duplicate_polygon_vertices(np.asarray(source_vertices, dtype=float), 1.0e-10)
            if int(self.field_flag) == 0:
                # Circle field: retain the complete ordered obstacle boundary as
                # one group.  The C++/Python evaluator will create edge points in
                # the body-fixed frame and fit one enclosing circle.
                if V_source.shape[0] >= 3 and signed_polygon_area(V_source) < 0.0:
                    V_source = np.flipud(V_source).copy()
                partitions = [V_source] if V_source.shape[0] >= 3 else []
            else:
                partitions = self.convex_partitions_for_original_polygon(V_source)
            if not partitions:
                failed_partition_count += 1
                rospy.logwarn_throttle(
                    1.0,
                    "[vertex_selector] failed to construct field geometry for obstacle %d; obstacle skipped",
                    int(source_obs_idx),
                )
                continue

            obs_type = self.get_obstacle_type(obstacle, source_obs_idx)
            for partition_idx, partition_vertices in enumerate(partitions):
                V = remove_duplicate_polygon_vertices(partition_vertices, 1.0e-10)
                if V.shape[0] < 3:
                    continue
                if signed_polygon_area(V) < 0.0:
                    V = np.flipud(V).copy()
                partition_group_id = int(next_partition_group_id)
                next_partition_group_id += 1
                distances = np.linalg.norm(V - ego_xy.reshape(1, 2), axis=1)
                for local_idx in range(int(V.shape[0])):
                    selected.append((
                        float(distances[local_idx]),
                        V[local_idx].copy(),
                        zero_normal.copy(),
                        int(obs_type),
                        int(source_obs_idx),
                        int(partition_group_id),
                        int(local_idx),
                        "polygon_vertex",
                        int(partition_idx),
                    ))

        if self.field_flag == 4:
            selected = _limit_selected_complete_groups(selected, self.F_max, self.N_n)
        return selected, len({int(r[4]) for r in selected}), len({int(r[5]) for r in selected}), int(failed_partition_count)

    def get_obstacle_velocity(self, obstacle, obs_idx):
        if obs_idx < 0 or obs_idx >= int(getattr(obstacle, "obs_cnt", 0)):
            return 0.0, 0.0
        vx = float(_safe_get_array(obstacle, "obs_vxs", obs_idx, 0.0))
        vy = float(_safe_get_array(obstacle, "obs_vys", obs_idx, 0.0))
        if not (np.isfinite(vx) and np.isfinite(vy)):
            return 0.0, 0.0
        return vx, vy

    def _pack_selected_publish_data(self, selected, obstacle, raycast_obstacle_meta=None):
        """Gather current/horizon publisher inputs once per selector cycle.

        Both /selected_vertex_data and /selected_vertex_horizon_data need the same
        x/y, velocity, type, and group metadata.  The old path decoded this data
        independently in both publishers and repeatedly allocated tiny NumPy arrays.
        """
        K = int(len(selected))
        xy = np.empty((K, 2), dtype=np.float64)
        vel = np.zeros((K, 2), dtype=np.float64)
        obs_type = np.empty(K, dtype=np.int32)
        group_id = np.empty(K, dtype=np.int32)
        local_idx = np.empty(K, dtype=np.int32)
        obstacle_ref = np.empty(K, dtype=np.int32)
        meta_map = raycast_obstacle_meta or {}
        raycast_mode = bool(self.use_raycast_shape_estimation)

        for k, item in enumerate(selected):
            p = item[1]
            base_type = int(item[3])
            ref = int(item[4])
            xy[k, 0] = float(p[0])
            xy[k, 1] = float(p[1])
            obstacle_ref[k] = ref
            group_id[k] = int(item[5])
            local_idx[k] = int(item[6])

            meta = meta_map.get(ref)
            effective_type = base_type
            vx = 0.0
            vy = 0.0
            if meta is not None:
                effective_type = int(meta.get("obs_type", base_type))
                mv = meta.get("velocity", None)
                if mv is not None:
                    vx = float(mv[0])
                    vy = float(mv[1])
            elif obstacle is not None and not raycast_mode:
                vx, vy = self.get_obstacle_velocity(obstacle, ref)

            if effective_type != 1 or not (math.isfinite(vx) and math.isfinite(vy)):
                vx = 0.0
                vy = 0.0
            vel[k, 0] = vx
            vel[k, 1] = vy
            obs_type[k] = effective_type

        return xy, vel, obs_type, group_id, local_idx, obstacle_ref

    def build_predicted_horizon_payload(self, selected, obstacle, raycast_obstacle_meta=None, packed=None):
        """Return N x K x 6: [x, y, 0, 0, type, group_id]."""
        H = int(self.horizon_N)
        if packed is not None:
            K = int(packed[0].shape[0])
        else:
            K = int(len(selected) if selected is not None else 0)
        payload = np.zeros((H, K, 6), dtype=np.float64)
        if K <= 0:
            return payload

        if packed is None:
            packed = self._pack_selected_publish_data(
                selected, obstacle, raycast_obstacle_meta=raycast_obstacle_meta
            )
        xy0, velocities, effective_types, group_ids, _local_idx, _obstacle_ref = packed
        tau = self._horizon_tau.reshape(H, 1)
        # Fill x/y independently to avoid allocating an H x K x 2 temporary.
        payload[:, :, 0] = xy0[None, :, 0] + tau * velocities[None, :, 0]
        payload[:, :, 1] = xy0[None, :, 1] + tau * velocities[None, :, 1]
        payload[:, :, 4] = effective_types[None, :]
        payload[:, :, 5] = group_ids[None, :]
        return payload

    def _horizon_layout_dims(self, K):
        K = int(K)
        dims = self._horizon_layout_cache.get(K)
        if dims is None:
            H = int(self.horizon_N)
            F = 6
            dims = [
                MultiArrayDimension(label="stage", size=H, stride=H * K * F),
                MultiArrayDimension(label="feature", size=K, stride=K * F),
                MultiArrayDimension(label="field", size=F, stride=F),
            ]
            self._horizon_layout_cache[K] = dims
        return dims

    def publish_selected_vertex_horizon_data(self, selected, obstacle, raycast_obstacle_meta=None, packed=None):
        payload = self.build_predicted_horizon_payload(
            selected, obstacle, raycast_obstacle_meta=raycast_obstacle_meta, packed=packed
        )
        K = int(payload.shape[1])
        msg = self._horizon_msg_cls()
        msg.layout.dim = self._horizon_layout_dims(K)
        msg.layout.data_offset = 0
        flat = payload.reshape(-1)
        msg.data = flat if self._use_numpy_horizon_msg else flat.tolist()
        self.pub_selected_vertex_horizon_data.publish(msg)

    def publish_selected_vertex_data(self, selected, frame_id, stamp, raycast_obstacle_meta=None, obstacle=None, packed=None):
        msg = obstacle_polygon()
        if hasattr(msg, "header"):
            msg.header.stamp = stamp
            msg.header.frame_id = frame_id

        max_cnt = len(msg.obs_xs)
        selected_count = int(packed[0].shape[0]) if packed is not None else int(len(selected) if selected is not None else 0)
        n_out = min(selected_count, max_cnt)
        msg.obs_cnt = int(n_out)
        if selected_count > max_cnt:
            rospy.logwarn_throttle(
                1.0,
                "[vertex_selector] selected vertex count %d exceeds message capacity %d; /selected_vertex_data is truncated",
                int(selected_count), int(max_cnt),
            )

        if packed is None:
            packed = self._pack_selected_publish_data(
                selected, obstacle, raycast_obstacle_meta=raycast_obstacle_meta
            )
        xy, velocities, effective_types, group_ids, local_indices, _obstacle_ref = packed

        # Cache generated-message array references once.  _safe_set_array performs
        # hasattr/getattr/len checks for every scalar and was dominating Python work.
        xs = msg.obs_xs
        ys = msg.obs_ys
        vxs = msg.obs_vxs
        vys = msg.obs_vys
        types = msg.obs_types
        rs = msg.obs_rs
        counts = msg.obs_vertex_counts
        for i in range(n_out):
            xs[i] = float(xy[i, 0])
            ys[i] = float(xy[i, 1])
            vxs[i] = float(velocities[i, 0])
            vys[i] = float(velocities[i, 1])
            types[i] = int(effective_types[i])
            rs[i] = float(group_ids[i])
            counts[i] = int(local_indices[i])

        self.pub_selected_vertex_data.publish(msg)
        # Primary selected vertices already use map.

    def copy_obstacle_to_percepted_msg(self, src, dst, src_idx, dst_idx):
        _safe_set_array(dst, "obs_xs", dst_idx, float(_safe_get_array(src, "obs_xs", src_idx, 0.0)))
        _safe_set_array(dst, "obs_ys", dst_idx, float(_safe_get_array(src, "obs_ys", src_idx, 0.0)))
        _safe_set_array(dst, "obs_vxs", dst_idx, float(_safe_get_array(src, "obs_vxs", src_idx, 0.0)))
        _safe_set_array(dst, "obs_vys", dst_idx, float(_safe_get_array(src, "obs_vys", src_idx, 0.0)))
        _safe_set_array(dst, "obs_types", dst_idx, int(self.get_obstacle_type(src, src_idx)))
        _safe_set_array(dst, "obs_rs", dst_idx, float(_safe_get_array(src, "obs_rs", src_idx, 0.0)))
        _safe_set_array(dst, "obs_zs", dst_idx, float(_safe_get_array(src, "obs_zs", src_idx, 0.0)))
        _safe_set_array(dst, "obs_vzs", dst_idx, float(_safe_get_array(src, "obs_vzs", src_idx, 0.0)))

        nv_reported = max(0, int(_safe_get_array(src, "obs_vertex_counts", src_idx, 0)))
        # Copy every polygon vertex that is physically representable by the
        # message layout; there is no separate selector-side vertex budget.
        nv = min(nv_reported, int(self.msg_max_vertices))
        _safe_set_array(dst, "obs_vertex_counts", dst_idx, int(nv))
        for j in range(nv):
            src_flat = src_idx * int(self.msg_max_vertices) + j
            dst_flat = dst_idx * int(self.msg_max_vertices) + j
            _safe_set_array(dst, "obs_poly_xs", dst_flat, float(_safe_get_array(src, "obs_poly_xs", src_flat, 0.0)))
            _safe_set_array(dst, "obs_poly_ys", dst_flat, float(_safe_get_array(src, "obs_poly_ys", src_flat, 0.0)))
            _safe_set_array(dst, "obs_poly_zs", dst_flat, float(_safe_get_array(src, "obs_poly_zs", src_flat, 0.0)))

    def publish_percepted_obstacles_cpp_buffers(self, pipeline, frame_id, stamp):
        """Publish perceived polygons directly from C++ output buffers.

        This avoids rebuilding fit_groups/segment dictionaries merely to publish
        /percepted_obstacle.  The geometry semantics match the raycast publisher:
        terminal-ray far point + visible fitted vertices + terminal-ray far point,
        with hit points as a rare fallback.
        """
        msg = obstacle_polygon()
        if hasattr(msg, "header"):
            msg.header.stamp = stamp
            msg.header.frame_id = frame_id

        counts = [int(v) for v in pipeline.counts]
        ng = counts[1]
        nv = counts[3]
        nt = counts[4]
        nh = counts[5]
        max_cnt = len(msg.obs_xs)
        n_out = min(int(ng), int(max_cnt))
        msg.obs_cnt = int(n_out)

        vertices = pipeline.vertices[:nv]
        terminal = pipeline.terminal[:nt]
        hits = pipeline.hits[:nh]
        vgid = np.rint(vertices[:, 0]).astype(np.int32, copy=False) if nv > 0 else np.empty(0, dtype=np.int32)
        tgid = np.rint(terminal[:, 0]).astype(np.int32, copy=False) if nt > 0 else np.empty(0, dtype=np.int32)
        hgid = np.rint(hits[:, 0]).astype(np.int32, copy=False) if nh > 0 else np.empty(0, dtype=np.int32)

        xs, ys = msg.obs_xs, msg.obs_ys
        vxs, vys = msg.obs_vxs, msg.obs_vys
        types, rs = msg.obs_types, msg.obs_rs
        zs, vzs = msg.obs_zs, msg.obs_vzs
        vcounts = msg.obs_vertex_counts
        pxs, pys, pzs = msg.obs_poly_xs, msg.obs_poly_ys, msg.obs_poly_zs
        max_vertices = int(self.msg_max_vertices)

        for gi in range(n_out):
            V = vertices[vgid == gi, 1:3] if nv > 0 else np.empty((0, 2), dtype=np.float64)
            T = terminal[tgid == gi] if nt > 0 else np.empty((0, 10), dtype=np.float64)

            start_far = None
            end_far = None
            if T.shape[0] > 0:
                start_rows = T[T[:, 1] < 0.0]
                end_rows = T[T[:, 1] >= 0.0]
                if start_rows.shape[0] > 0:
                    start_far = start_rows[0, 4:6]
                if end_rows.shape[0] > 0:
                    end_far = end_rows[0, 4:6]

            n_extra = int(start_far is not None) + int(end_far is not None)
            if V.shape[0] + n_extra >= 3:
                P = np.empty((V.shape[0] + n_extra, 2), dtype=np.float64)
                k = 0
                if start_far is not None:
                    P[k] = start_far
                    k += 1
                if V.shape[0] > 0:
                    P[k:k + V.shape[0]] = V
                    k += V.shape[0]
                if end_far is not None:
                    P[k] = end_far
            else:
                P = hits[hgid == gi, 1:3].copy() if nh > 0 else np.empty((0, 2), dtype=np.float64)

            # Remove only consecutive duplicates (and a repeated closing vertex),
            # matching the C++ dedupe behavior without Python point objects.
            if P.shape[0] > 1:
                keep = np.ones(P.shape[0], dtype=bool)
                d = P[1:] - P[:-1]
                keep[1:] = np.einsum("ij,ij->i", d, d) > 1.0e-12
                P = P[keep]
                if P.shape[0] > 1:
                    dd = P[0] - P[-1]
                    if float(np.dot(dd, dd)) <= 1.0e-12:
                        P = P[:-1]

            if P.shape[0] > max_vertices:
                # Integer endpoint-preserving sampling; no linspace/unique allocation.
                n = int(P.shape[0])
                if max_vertices <= 1:
                    P = P[:max_vertices]
                else:
                    idxs = (np.arange(max_vertices, dtype=np.int64) * (n - 1) // (max_vertices - 1))
                    P = P[idxs]

            nvp = min(int(P.shape[0]), max_vertices)
            center = np.mean(P[:nvp], axis=0) if nvp > 0 else np.zeros(2, dtype=np.float64)
            mm = pipeline.motion_meta[gi] if gi < pipeline.motion_meta.shape[0] else None
            obs_type = int(round(mm[1])) if mm is not None else 0
            vx = float(mm[2]) if mm is not None and obs_type == 1 and math.isfinite(float(mm[2])) else 0.0
            vy = float(mm[3]) if mm is not None and obs_type == 1 and math.isfinite(float(mm[3])) else 0.0

            xs[gi] = float(center[0])
            ys[gi] = float(center[1])
            vxs[gi] = vx
            vys[gi] = vy
            types[gi] = obs_type
            rs[gi] = float(gi)
            zs[gi] = 0.0
            vzs[gi] = 0.0
            vcounts[gi] = int(nvp)
            base = gi * max_vertices
            for j in range(nvp):
                pxs[base + j] = float(P[j, 0])
                pys[base + j] = float(P[j, 1])
                pzs[base + j] = 0.0

        self.pub_percepted_obstacle.publish(msg)
        # Primary perceived obstacles already use map.

    def publish_percepted_obstacles_raycast(self, fit_groups, frame_id, stamp):
        """Publish raycast-reconstructed perceived obstacles with low Python overhead."""
        msg = obstacle_polygon()
        if hasattr(msg, "header"):
            msg.header.stamp = stamp
            msg.header.frame_id = frame_id

        max_cnt = len(msg.obs_xs)
        groups = fit_groups[:max_cnt] if isinstance(fit_groups, list) else list(fit_groups)[:max_cnt]
        msg.obs_cnt = int(len(groups))
        stride = int(self.msg_max_vertices)

        xs = msg.obs_xs
        ys = msg.obs_ys
        vxs = msg.obs_vxs
        vys = msg.obs_vys
        types = msg.obs_types
        rs = msg.obs_rs
        zs = msg.obs_zs
        vzs = msg.obs_vzs
        counts = msg.obs_vertex_counts
        pxs = msg.obs_poly_xs
        pys = msg.obs_poly_ys
        pzs = msg.obs_poly_zs

        for out_i, group in enumerate(groups):
            raycast_obs_idx = int(group.get("raycast_obs_idx", out_i))
            obs_type = int(group.get("obs_type", 0))
            velocity = group.get("velocity", None)
            vx = float(velocity[0]) if velocity is not None else 0.0
            vy = float(velocity[1]) if velocity is not None else 0.0
            if not (math.isfinite(vx) and math.isfinite(vy)):
                vx = vy = 0.0

            V = group.get("vertices", None)
            if V is None:
                V = np.empty((0, 2), dtype=np.float64)
            elif not isinstance(V, np.ndarray):
                V = np.asarray(V, dtype=np.float64).reshape(-1, 2)
            else:
                V = V.reshape(-1, 2)

            start_far = None
            end_far = None
            for edge in (group.get("terminal_ray_edges", None) or ()):
                side = edge.get("side")
                if side == "start":
                    start_far = edge.get("end")
                elif side == "end":
                    end_far = edge.get("end")

            nraw = int(V.shape[0]) + (1 if start_far is not None else 0) + (1 if end_far is not None else 0)
            if nraw >= 3:
                P = np.empty((nraw, 2), dtype=np.float64)
                pos = 0
                if start_far is not None:
                    P[pos, 0] = float(start_far[0]); P[pos, 1] = float(start_far[1]); pos += 1
                nv_v = int(V.shape[0])
                if nv_v:
                    P[pos:pos + nv_v, :] = V
                    pos += nv_v
                if end_far is not None:
                    P[pos, 0] = float(end_far[0]); P[pos, 1] = float(end_far[1])
            else:
                hp = group.get("hit_points", None)
                if hp is None:
                    P = np.empty((0, 2), dtype=np.float64)
                elif isinstance(hp, np.ndarray):
                    P = hp.reshape(-1, 2)
                else:
                    P = np.asarray(hp, dtype=np.float64).reshape(-1, 2)

            # build_vertices() already removes adjacent duplicate fitted vertices.
            # Only strip an accidental first/last duplicate here; avoid the old
            # list -> ndarray -> dedupe ndarray round trip on every obstacle.
            if P.shape[0] > 1:
                d0 = float(P[0, 0] - P[-1, 0])
                d1 = float(P[0, 1] - P[-1, 1])
                if d0 * d0 + d1 * d1 <= 1.0e-12:
                    P = P[:-1]

            pn = int(P.shape[0])
            if pn > stride:
                # Integer arithmetic gives deterministic evenly spread indices
                # without allocating linspace + round + unique temporaries.
                idx = (np.arange(stride, dtype=np.int64) * (pn - 1)) // max(1, stride - 1)
                P = P[idx]
                pn = int(P.shape[0])

            nv = min(pn, stride)
            if nv > 0:
                center_x = float(np.sum(P[:nv, 0])) / float(nv)
                center_y = float(np.sum(P[:nv, 1])) / float(nv)
            else:
                center_x = center_y = 0.0

            xs[out_i] = center_x
            ys[out_i] = center_y
            vxs[out_i] = vx if obs_type == 1 else 0.0
            vys[out_i] = vy if obs_type == 1 else 0.0
            types[out_i] = obs_type
            rs[out_i] = float(raycast_obs_idx)
            zs[out_i] = 0.0
            vzs[out_i] = 0.0
            counts[out_i] = nv

            base = out_i * stride
            for j in range(nv):
                k = base + j
                pxs[k] = float(P[j, 0])
                pys[k] = float(P[j, 1])
                pzs[k] = 0.0

        self.pub_percepted_obstacle.publish(msg)
        # Primary perceived obstacles already use map.

    def publish_percepted_obstacles(self, obstacle, selected, frame_id, stamp):
        """Legacy polygon-mode publisher using original selected world polygons."""
        msg = obstacle_polygon()
        if hasattr(msg, "header"):
            msg.header.stamp = stamp
            msg.header.frame_id = frame_id

        selected_obs_indices = sorted(set(int(item[4]) for item in selected))
        max_cnt = len(msg.obs_xs) if hasattr(msg, "obs_xs") else 0
        selected_obs_indices = selected_obs_indices[:max_cnt]
        msg.obs_cnt = int(len(selected_obs_indices))

        for out_i, src_idx in enumerate(selected_obs_indices):
            self.copy_obstacle_to_percepted_msg(obstacle, msg, src_idx, out_i)

        self.pub_percepted_obstacle.publish(msg)
        # Primary perceived obstacles already use map.

    def _publisher_has_consumer(self, publisher):
        if not bool(getattr(self, "skip_unsubscribed_aux_publish", True)):
            return True
        try:
            return int(publisher.get_num_connections()) > 0
        except Exception:
            # Preserve behavior for mocked/nonstandard publishers.
            return True

    def step(self):
        if not self.have_ego:
            rospy.logwarn_throttle(1.0, "[vertex_selector] waiting for /ego_state...")
            return
        if bool(self.use_raycast_shape_estimation) and bool(self.use_external_raycast):
            if not self.have_raycast_cloud:
                rospy.logwarn_throttle(1.0, "[vertex_selector] waiting for %s...", (self.velodyne_points_topic if self.input_source == "velodyne_points" else self.raycast_point_cloud_topic))
                return
        elif not (self.have_obstacle and self.latest_obstacle_msg is not None):
            rospy.logwarn_throttle(1.0, "[vertex_selector] waiting for /obstacle...")
            return

        # Measure the complete selector step.  This timing log is always enabled
        # (throttled below), independently of ~debug_timing.
        step_t0 = time.perf_counter()

        obstacle = self.latest_obstacle_msg
        frame_id = self.frame_id  # Geometry is computed in map, not relabeled.
        stamp = (self.latest_raycast_observation_stamp
                 if self.input_source == "velodyne_points" and self.latest_raycast_observation_stamp is not None
                 else rospy.Time.now())
        raycast_obstacle_meta = None
        fit_groups = None
        now_sec = float(stamp.to_sec())

        visualization_period_due = bool(
            self.visualization_hz > 0.0
            and now_sec - self._last_visualization_sec >= 1.0 / self.visualization_hz
        )
        ray_viz_due = bool(
            visualization_period_due
            and self.publish_raycast_viz
            and self._publisher_has_consumer(self.pub_raycast_viz)
        )
        line_viz_due = bool(
            visualization_period_due
            and self.publish_line_fit_viz
            and self._publisher_has_consumer(self.pub_line_fit_viz)
        )
        motion_debug_due = bool(
            self.motion_debug_hz > 0.0
            and now_sec - self._last_motion_debug_sec >= 1.0 / self.motion_debug_hz
            and self._publisher_has_consumer(self.pub_estimated_vertex_motion)
        )
        perceived_due = bool(
            self.perceived_obstacle_hz <= 0.0
            or now_sec - self._last_perceived_publish_sec >= 1.0 / self.perceived_obstacle_hz
        )
        perceived_needed = bool(
            perceived_due and (self._publisher_has_consumer(self.pub_percepted_obstacle)
                               or (self.pub_percepted_obstacle_odom is not None and self._publisher_has_consumer(self.pub_percepted_obstacle_odom)))
        )

        # Ray dictionaries are used only by the RViz ray marker.  Avoid both the
        # C++ -> Python marshalling and thousands of geometry_msgs/Point objects
        # when RViz is not actually subscribed.
        self._emit_cpp_ray_records = bool(ray_viz_due)
        self._emit_cpp_motion_records = bool(motion_debug_due or line_viz_due)
        # The C++ buffers already contain the full geometry.  Reconstruct Python
        # dict/list geometry only on auxiliary cycles that actually consume it.
        self._emit_cpp_python_geometry = bool(
            line_viz_due or bool(getattr(self, "debug_timing", False))
        )

        geometry_t0 = time.perf_counter()
        if bool(self.use_raycast_shape_estimation):
            (
                selected,
                selected_obstacle_count,
                selected_group_count,
                failed_group_count,
                ray_records,
                fit_groups,
                raycast_obstacle_meta,
            ) = self.collect_selected_vertices_raycast(
                obstacle,
                ray_records=(self.latest_raycast_rows if self.use_external_raycast else None),
            )
            # External C++ path does not need to regenerate fitting just to draw
            # ray markers. Convert the cached raw rows to legacy dictionaries only
            # on actual ray-visualization cycles.
            if self.use_external_raycast and ray_viz_due and not ray_records:
                ray_records = _CppVertexPipeline.ray_rows_to_records(self.latest_raycast_rows)
            geometry_ms = (time.perf_counter() - geometry_t0) * 1000.0

            if getattr(self, "cpp_vertex_pipeline", None) is not None:
                motion_ms = float(getattr(self.cpp_vertex_pipeline, "last_motion_ms", 0.0))
                geometry_ms = max(0.0, float(geometry_ms) - motion_ms)
                vertex_motion_records = list(getattr(self.cpp_vertex_pipeline, "last_motion_records", []) or [])
            else:
                motion_t0 = time.perf_counter()
                motion_stamp = (
                    self.latest_raycast_observation_stamp
                    if self.use_external_raycast
                    else self.latest_obstacle_observation_stamp
                )
                if motion_stamp is None:
                    motion_stamp = stamp
                vertex_motion_records, raycast_obstacle_meta = self.estimate_fitted_vertex_motion(
                    fit_groups or [], motion_stamp, raycast_obstacle_meta=raycast_obstacle_meta
                )
                motion_ms = (time.perf_counter() - motion_t0) * 1000.0
            selector_mode = "raycast_fit"
        else:
            selected, selected_obstacle_count, selected_group_count, failed_group_count = self.collect_selected_vertices(obstacle)
            geometry_ms = (time.perf_counter() - geometry_t0) * 1000.0
            motion_ms = 0.0
            vertex_motion_records = []
            ray_records = []
            selector_mode = "polygon"

        viz_t0 = time.perf_counter()
        if motion_debug_due:
            self.publish_estimated_vertex_motion(vertex_motion_records)
            self._last_motion_debug_sec = now_sec
        if bool(self.use_raycast_shape_estimation):
            if ray_viz_due:
                self.publish_raycast_visualization(ray_records, frame_id, stamp)
            if line_viz_due:
                self.publish_line_fit_visualization(fit_groups, selected, frame_id, stamp)
            if ray_viz_due or line_viz_due:
                self._last_visualization_sec = now_sec
        viz_ms = (time.perf_counter() - viz_t0) * 1000.0

        pub_prep_t0 = time.perf_counter()
        cpp_pipeline = getattr(self, "cpp_vertex_pipeline", None)
        if bool(self.use_raycast_shape_estimation) and cpp_pipeline is not None:
            packed_publish = cpp_pipeline.last_packed_publish
        else:
            packed_publish = self._pack_selected_publish_data(
                selected, obstacle, raycast_obstacle_meta=raycast_obstacle_meta
            )
        pub_prep_ms = (time.perf_counter() - pub_prep_t0) * 1000.0

        current_t0 = time.perf_counter()
        self.publish_selected_vertex_data(
            selected, frame_id, stamp, raycast_obstacle_meta=raycast_obstacle_meta,
            obstacle=obstacle, packed=packed_publish,
        )
        current_pub_ms = (time.perf_counter() - current_t0) * 1000.0

        horizon_t0 = time.perf_counter()
        self.publish_selected_vertex_horizon_data(
            selected, obstacle, raycast_obstacle_meta=raycast_obstacle_meta,
            packed=packed_publish,
        )
        horizon_pub_ms = (time.perf_counter() - horizon_t0) * 1000.0

        perceived_pub_ms = 0.0
        if perceived_needed:
            aux_t0 = time.perf_counter()
            if bool(self.use_raycast_shape_estimation):
                cpp_pipeline = getattr(self, "cpp_vertex_pipeline", None)
                if cpp_pipeline is not None:
                    self.publish_percepted_obstacles_cpp_buffers(cpp_pipeline, frame_id, stamp)
                else:
                    self.publish_percepted_obstacles_raycast(fit_groups or [], frame_id, stamp)
            else:
                self.publish_percepted_obstacles(obstacle, selected, frame_id, stamp)
            perceived_pub_ms = (time.perf_counter() - aux_t0) * 1000.0
            self._last_perceived_publish_sec = now_sec

        # Always expose the performance breakdown.  rospy.loginfo_throttle avoids
        # synchronous per-cycle console I/O while still making a 300-ms bottleneck
        # immediately visible without requiring ~debug_timing:=true.
        total_step_ms = (time.perf_counter() - step_t0) * 1000.0
        accounted_ms = (
            geometry_ms + motion_ms + viz_ms + pub_prep_ms + current_pub_ms + horizon_pub_ms
            + perceived_pub_ms
        )
        other_ms = max(0.0, total_step_ms - accounted_ms)
        rospy.loginfo_throttle(
            0.5,
            "[vertex_selector][timing] total=%.3f ms | cpp=%.3f | cpp_motion=%.3f | geometry=%.3f | motion=%.3f | viz=%.3f | pub_prep=%.3f | current_pub=%.3f | horizon_pub=%.3f | perceived_pub=%.3f | other=%.3f",
            float(total_step_ms),
            float(getattr(self, "cpp_vertex_kernel_ms", 0.0)),
            float(getattr(getattr(self, "cpp_vertex_pipeline", None), "last_motion_ms", 0.0)),
            float(geometry_ms), float(motion_ms), float(viz_ms), float(pub_prep_ms),
            float(current_pub_ms), float(horizon_pub_ms),
            float(perceived_pub_ms), float(other_ms),
        )

        # Extra semantic diagnostics remain optional.
        if bool(getattr(self, "debug_timing", False)):
            if packed_publish is not None:
                dyn_count = int(np.count_nonzero(packed_publish[2] == 1))
            else:
                dyn_count = 0
            tracked_count = 0
            estimated_obstacle_count = 0
            mean_obstacle_speed = 0.0
            if fit_groups:
                tracked_count = sum(
                    1 for group in fit_groups for rec in (group.get("vertex_motion", []) or [])
                    if bool(rec.get("matched", False))
                )
                estimated_groups = [
                    group for group in fit_groups if bool(group.get("velocity_valid", False))
                ]
                estimated_obstacle_count = int(len(estimated_groups))
                if estimated_groups:
                    mean_obstacle_speed = float(np.mean([
                        float(group.get("estimated_speed", 0.0)) for group in estimated_groups
                    ]))

            rospy.loginfo_throttle(
                0.5,
                "[vertex_selector] mode=%s selected_vertices=%d dyn_vertices=%d perceived_obstacles=%d geometry_groups=%d fit/partition_failures=%d matched_vertices=%d velocity_estimated_obstacles=%d mean_obstacle_speed=%.3f m/s max_obs=%d",
                str(selector_mode), int(packed_publish[0].shape[0] if packed_publish is not None else 0), int(dyn_count),
                int(selected_obstacle_count), int(selected_group_count),
                int(failed_group_count), int(tracked_count),
                int(estimated_obstacle_count), float(mean_obstacle_speed), int(self.max_obs),
            )

def main():
    rospy.init_node("vertex_selector", anonymous=False)
    node = VertexSelectorNode()
    rate = rospy.Rate(max(1.0, float(node.hz)))

    while not rospy.is_shutdown():
        t0 = time.perf_counter()
        node.step()
        cal_time_ms = (time.perf_counter() - t0) * 1000.0

        # Timing is emitted inside step() with a per-stage breakdown.
        # Do not add a second per-cycle console print here.

        rate.sleep()


if __name__ == "__main__":
    main()
